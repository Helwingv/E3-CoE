---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Directory from "../../components/react/Directory";
import StickyCTA from "../../components/StickyCTA.astro";
import { getCollection } from "astro:content";

const partners = await getCollection("partners");
const data = partners.map(p => ({
  orgName: p.data.orgName,
  sector: p.data.sector,
  county: p.data.county,
  url: p.data.url
}));
---

<BaseLayout
  title="Partner Directory | Resources | Vision 8:28"
  description="A curated network of trusted partners across government, industry, education, finance, and community development."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              An Ecosystem Built on Collaboration
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              A curated network of trusted partners across government, industry, education, finance, and community development.
            </p>
          </div>
          <a
            href="#directory"
            class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
          >
            Explore the Partner Network
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-4xl font-bold text-slate-900 mb-6 text-center">
            The Window Of Opportunity
          </h2>
          <div class="space-y-6 text-lg text-slate-600 leading-relaxed">
            <p>
              No single organization has the capacity or ability to build an economy alone. Impact accelerates when the right partners find each other faster.
            </p>
            <p>
              Vision 8:28 is transparent and open to invitation to have a seat at your table, and the welcome mat is out for you to have a seat at our table.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            What the Directory Delivers
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Connect with the right organizations to advance your economic development goals
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Verified Public-Sector Partners
                </h3>
                <p class="text-slate-600 mb-4">
                  → Agencies, municipalities, and regional entities
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Connect with government agencies, county offices, and municipal organizations working to support economic growth and community development across the region.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Private & Industry Partners
                </h3>
                <p class="text-slate-600 mb-4">
                  → Employers, investors, and solution providers
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Engage with private sector leaders, businesses, investors, and industry experts who are driving innovation and creating opportunities for regional growth.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Nonprofit & Community Organizations
                </h3>
                <p class="text-slate-600 mb-4">
                  → On-the-ground implementers and advocates
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Partner with nonprofit organizations and community groups that are directly serving residents, implementing programs, and advocating for equitable economic opportunity.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Academic & Workforce Institutions
                </h3>
                <p class="text-slate-600 mb-4">
                  → Talent and research alignment
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Collaborate with colleges, universities, technical schools, and workforce development organizations to align talent pipelines with regional economic needs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Built on Trust & Transparency
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-[#24a4b9] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Vetted, Mission-Aligned Partners
            </h3>
            <p class="text-slate-600">
              All partners are carefully vetted to ensure they share our commitment to regional prosperity and inclusive economic development.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#24a4b9] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Transparent Participation Criteria
            </h3>
            <p class="text-slate-600">
              Clear, publicly available criteria ensure fairness and accountability in partner selection and ongoing participation.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#24a4b9] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Built for Collaboration, Not Promotion
            </h3>
            <p class="text-slate-600">
              This directory exists to facilitate meaningful partnerships and collective impact, not as a marketing platform.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="directory" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Browse Our Partner Network
          </h2>
          <p class="text-lg text-slate-600">
            Filter by sector and county to find the right partners for your needs
          </p>
        </div>
        <Directory client:load data={data} />
      </div>
    </section>

    <section class="py-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h3 class="text-3xl font-bold mb-4">
          Ready to Join the Network?
        </h3>
        <p class="text-slate-300 text-lg mb-8">
          Become part of a trusted ecosystem working together to drive regional economic prosperity.
        </p>
        <a
          href="/partnership/join"
          class="inline-block bg-[#24a4b9] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
        >
          Become a CEDC Partner
        </a>
      </div>
    </section>

    <StickyCTA
      title="Access Growth Intelligence"
      description="Get actionable insights, data, and resources to accelerate regional economic development."
      ctaText="Access Growth Intelligence"
      ctaHref="/resources/guides-toolkits"
    />
  </div>
</BaseLayout>
