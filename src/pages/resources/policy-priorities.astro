---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout
  title="Policy Priorities | Resources | E3 CoE"
  description="E3 CoE advances strategic policy grounded in economic mobility, entrepreneurship growth, and regional competitiveness."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Advocacy That Moves Markets.<br />Policy That Moves People.
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-3">
              E3 CoE advances strategic policy, cross-sector collaboration, and data-informed advocacy to accelerate community and economic development outcomes at the local, regional, and national levels.
            </p>
            <p class="text-lg text-[#5B9BD5] font-semibold">
              We do not advocate for noise. We advocate for measurable transformation.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#priorities"
              class="inline-block bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
            >
              View Policy Priorities
            </a>
            <a
              href="/resources/collaboration"
              class="inline-block bg-white/10 border border-white/20 text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/20 transition-colors duration-200"
            >
              Join The Advocacy Network
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-bold text-slate-900 mb-6">
          Policy Built On Outcomes — Not Political Agendas or Ideologies.
        </h2>
        <p class="text-xl text-slate-600 leading-relaxed">
          E3 CoE's advocacy framework aligns public policy with economic mobility, entrepreneurship growth, and regional competitiveness. Our policy priorities are grounded in best practices from leading economic development organizations — including models such as the International Economic Development Council and frameworks advanced by the U.S. Economic Development Administration — while tailored to the real-world needs of the communities we serve.
        </p>
      </div>
    </section>

    <section id="priorities" class="py-10 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-8">

          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="grid lg:grid-cols-3">
              <div class="bg-slate-900 text-white p-10 flex flex-col justify-between">
                <div>
                  <div class="text-[#5B9BD5] text-sm font-bold uppercase tracking-widest mb-3">Priority 01</div>
                  <h3 class="text-2xl font-bold mb-4">Workforce & Talent Development</h3>
                  <p class="text-slate-400 leading-relaxed text-sm">Building the talent pipelines that power regional economic competitiveness.</p>
                </div>
                <div class="mt-8 pt-8 border-t border-slate-700">
                  <div class="text-xs text-slate-400 uppercase tracking-widest mb-2">Impact Focus</div>
                  <p class="text-white font-medium">Reduce talent gaps. Increase regional competitiveness. Strengthen middle-class mobility.</p>
                </div>
              </div>
              <div class="lg:col-span-2 p-10">
                <h4 class="text-lg font-bold text-slate-900 mb-6">We Advocate For:</h4>
                <ul class="space-y-4">
                  {[
                    "Modernized workforce pipelines aligned with regional industry clusters",
                    "Apprenticeship and credential reform",
                    "Public-private workforce partnerships",
                    "Funding alignment between education and employer demand"
                  ].map(item => (
                    <li class="flex items-start gap-3">
                      <div class="w-5 h-5 rounded-full bg-[#5B9BD5] bg-opacity-10 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-[#5B9BD5]"></div>
                      </div>
                      <span class="text-slate-700 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="grid lg:grid-cols-3">
              <div class="bg-slate-900 text-white p-10 flex flex-col justify-between">
                <div>
                  <div class="text-[#5B9BD5] text-sm font-bold uppercase tracking-widest mb-3">Priority 02</div>
                  <h3 class="text-2xl font-bold mb-4">Small Business & Entrepreneurial Ecosystems</h3>
                  <p class="text-slate-400 leading-relaxed text-sm">Empowering entrepreneurs to build the local economies of tomorrow.</p>
                </div>
                <div class="mt-8 pt-8 border-t border-slate-700">
                  <div class="text-xs text-slate-400 uppercase tracking-widest mb-2">Impact Focus</div>
                  <p class="text-white font-medium">Build resilient local economies powered by entrepreneurship.</p>
                </div>
              </div>
              <div class="lg:col-span-2 p-10">
                <h4 class="text-lg font-bold text-slate-900 mb-6">We Support Policies That:</h4>
                <ul class="space-y-4">
                  {[
                    "Increase access to capital for underserved entrepreneurs",
                    "Expand technical assistance funding",
                    "Streamline procurement pathways",
                    "Incentivize innovation-driven small businesses"
                  ].map(item => (
                    <li class="flex items-start gap-3">
                      <div class="w-5 h-5 rounded-full bg-[#5B9BD5] bg-opacity-10 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-[#5B9BD5]"></div>
                      </div>
                      <span class="text-slate-700 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="grid lg:grid-cols-3">
              <div class="bg-slate-900 text-white p-10 flex flex-col justify-between">
                <div>
                  <div class="text-[#5B9BD5] text-sm font-bold uppercase tracking-widest mb-3">Priority 03</div>
                  <h3 class="text-2xl font-bold mb-4">Infrastructure & Innovation</h3>
                  <p class="text-slate-400 leading-relaxed text-sm">Laying the physical and digital foundation for scalable growth.</p>
                </div>
                <div class="mt-8 pt-8 border-t border-slate-700">
                  <div class="text-xs text-slate-400 uppercase tracking-widest mb-2">Impact Focus</div>
                  <p class="text-white font-medium">Create the foundation for scalable regional growth.</p>
                </div>
              </div>
              <div class="lg:col-span-2 p-10">
                <h4 class="text-lg font-bold text-slate-900 mb-6">We Advocate For:</h4>
                <ul class="space-y-4">
                  {[
                    "Digital infrastructure expansion",
                    "Smart-city and regional innovation investments",
                    "Broadband access equity",
                    "Infrastructure modernization tied to economic corridors (IEDCs – Infrastructure Edge Data Centers)"
                  ].map(item => (
                    <li class="flex items-start gap-3">
                      <div class="w-5 h-5 rounded-full bg-[#5B9BD5] bg-opacity-10 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-[#5B9BD5]"></div>
                      </div>
                      <span class="text-slate-700 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="grid lg:grid-cols-3">
              <div class="bg-slate-900 text-white p-10 flex flex-col justify-between">
                <div>
                  <div class="text-[#5B9BD5] text-sm font-bold uppercase tracking-widest mb-3">Priority 04</div>
                  <h3 class="text-2xl font-bold mb-4">Community Investment & Inclusive Growth</h3>
                  <p class="text-slate-400 leading-relaxed text-sm">Ensuring economic growth reaches every corner of the community.</p>
                </div>
                <div class="mt-8 pt-8 border-t border-slate-700">
                  <div class="text-xs text-slate-400 uppercase tracking-widest mb-2">Impact Focus</div>
                  <p class="text-white font-medium">Economic growth that includes — not excludes.</p>
                </div>
              </div>
              <div class="lg:col-span-2 p-10">
                <h4 class="text-lg font-bold text-slate-900 mb-6">E3 CoE Supports:</h4>
                <ul class="space-y-4">
                  {[
                    "Incentive reforms tied to measurable outcomes",
                    "Opportunity-zone accountability standards",
                    "Regional wealth-building strategies",
                    "Housing and transportation alignment with workforce development"
                  ].map(item => (
                    <li class="flex items-start gap-3">
                      <div class="w-5 h-5 rounded-full bg-[#5B9BD5] bg-opacity-10 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-[#5B9BD5]"></div>
                      </div>
                      <span class="text-slate-700 leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Policy Dashboard
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Track current legislation, regional policy initiatives, and federal funding opportunities — updated as the policy landscape evolves.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {[
            {
              label: "Current Legislation",
              description: "Active bills and policies at federal, state, and municipal levels relevant to regional economic development.",
              icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
              badge: "Live"
            },
            {
              label: "Regional Policy Initiatives",
              description: "Local and regional efforts shaping community investment, workforce alignment, and economic corridors.",
              icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7",
              badge: "Active"
            },
            {
              label: "Federal & State Funding",
              description: "Open grant opportunities, federal allocations, and state-level economic development funding cycles.",
              icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
              badge: "Opportunities"
            },
            {
              label: "Public Comment Periods",
              description: "Open windows for community and organizational input on proposed regulations and policy changes.",
              icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
              badge: "Open"
            }
          ].map(item => (
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 hover:shadow-md transition-shadow duration-200">
              <div class="flex items-start justify-between mb-4">
                <div class="w-10 h-10 bg-[#5B9BD5] bg-opacity-10 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
                  </svg>
                </div>
                <span class="text-xs font-bold text-[#5B9BD5] bg-[#5B9BD5]/10 px-2 py-1 rounded-full">{item.badge}</span>
              </div>
              <h3 class="font-bold text-slate-900 mb-2">{item.label}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h3 class="text-3xl font-bold text-slate-900 mb-4">
          Stay Ahead of the Policy Curve
        </h3>
        <p class="text-slate-600 text-lg mb-10">
          Access E3 CoE's policy briefs, request a consultation, or subscribe to advocacy updates.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/contact"
            class="inline-block bg-[#5B9BD5] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
          >
            Request A Policy Consultation
          </a>
          <a
            href="/resources/collaboration"
            class="inline-block border-2 border-slate-300 text-slate-700 px-10 py-4 rounded-lg font-semibold text-lg hover:border-slate-400 hover:bg-slate-50 transition-colors duration-200"
          >
            Subscribe To Advocacy Updates
          </a>
        </div>
      </div>
    </section>

    <StickyCTA
      title="Advocacy That Drives Transformation"
      description="Join E3 CoE's advocacy network and shape the policies that power regional economic growth."
      ctaText="Join The Advocacy Network"
      ctaHref="/resources/collaboration"
    />
  </div>
</BaseLayout>
