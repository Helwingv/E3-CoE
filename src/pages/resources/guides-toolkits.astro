---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
import { getCollection } from "astro:content";

const resources = (await getCollection("resources")).filter(r => r.data.type === "guide" || r.data.type === "tool");
---

<BaseLayout
  title="Guides & Toolkits | Resources | E3 CoE"
  description="Actionable guides and toolkits designed for practitioners, policymakers, and partners who are responsible for delivering results—not just plans."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Practical Intelligence for Sustainable Economic Development Work
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              Actionable guides and toolkits designed for practitioners, policymakers, and partners who are responsible for delivering results—not just plans.
            </p>
          </div>
          <a
            href="#toolkits"
            class="inline-block bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
          >
            Browse Guides & Toolkits
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            The Pain Point
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed mb-6">
            Economic development leaders are often forced to navigate complexity without practical, field-tested guidance. Too much theory. Not enough execution.
          </p>
          <p class="text-xl text-slate-900 font-semibold leading-relaxed">
            E3 CoE provides actionable "Playbooks" that are easy to execute and support our partners with education and training to complement our subject-matter expertise.
          </p>
        </div>
      </div>
    </section>

    <section id="toolkits" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            What You'll Find
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Value-driven resources that accelerate implementation
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Governance & Compliance Toolkits
                </h3>
                <p class="text-slate-600 mb-4">
                  → Reduce risk and increase funder confidence
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Structured frameworks and templates to ensure your organization meets regulatory requirements, maintains transparency, and builds trust with funders and stakeholders.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Program Design & Execution Frameworks
                </h3>
                <p class="text-slate-600 mb-4">
                  → Move from concept to implementation faster
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Step-by-step methodologies that help you design, launch, and scale economic development programs with clarity and confidence.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Board & Committee Playbooks
                </h3>
                <p class="text-slate-600 mb-4">
                  → Strengthen oversight, accountability, compliance, and impact
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Practical tools to help boards and committees govern effectively, make informed decisions, and drive meaningful outcomes.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Economic Development CoE Best Practices
                </h3>
                <p class="text-slate-600 mb-4">
                  → Learn from what actually works in the field
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Evidence-based practices and lessons learned from successful Centers of Excellence that deliver measurable economic impact.
                </p>
              </div>
            </div>
          </div>
        </div>

        {resources.length > 0 && (
          <div class="mt-16">
            <h3 class="text-2xl font-bold text-slate-900 mb-8 text-center">
              Available Resources
            </h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
              {resources.map(resource => (
                <div class="bg-white border border-slate-200 rounded-lg p-6 hover:shadow-md transition-all duration-200">
                  <h4 class="font-bold text-slate-900 mb-2">{resource.data.title}</h4>
                  <p class="text-xs text-slate-500 mb-3 uppercase tracking-wide">{resource.data.type}</p>
                  {resource.data.url && (
                    <a
                      href={resource.data.url}
                      class="inline-flex items-center text-[#5B9BD5] font-semibold hover:text-[#3D7FC1] transition-colors"
                    >
                      Access Resource
                      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Validation
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-[#5B9BD5] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Designed to Meet Federal & State Standards
            </h3>
            <p class="text-slate-600">
              Our toolkits are built to align with regulatory requirements and compliance standards at all levels of government.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#5B9BD5] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Built by Practitioners & Advisors
            </h3>
            <p class="text-slate-600">
              Created by experienced professionals who understand the real-world challenges of economic development work.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#5B9BD5] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Used by Public, Private, & Nonprofit Leaders
            </h3>
            <p class="text-slate-600">
              Trusted across sectors by organizations committed to creating sustainable economic impact.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h3 class="text-3xl font-bold mb-4">
          Ready to Get Started?
        </h3>
        <p class="text-slate-300 text-lg mb-8">
          Access practical tools and frameworks designed to accelerate your economic development work.
        </p>
        <a
          href="/contact"
          class="inline-block bg-[#5B9BD5] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
        >
          Download a Toolkit
        </a>
      </div>
    </section>

    <StickyCTA
      title="Access Growth Intelligence"
      description="Get actionable insights, data, and resources to accelerate regional economic development."
      ctaText="Access Growth Intelligence"
      ctaHref="/resources/guides-toolkits"
    />
  </div>
</BaseLayout>
