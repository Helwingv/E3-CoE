---
import { TABLES } from "../lib/tables";
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SupporterStrip from "../components/SupporterStrip.astro";
import { site } from "../config/site";
import { getServerSupabase } from "../lib/serverSupabase";

const supabase = getServerSupabase();

const { data: news } = supabase
  ? await supabase
  .from(TABLES.news)
  .select("id,title,slug,excerpt,category,published_at")
  .eq("is_published", true)
  .order("published_at", { ascending: false })
  .limit(3)
  : { data: null };

const { data: events } = supabase
  ? await supabase
  .from(TABLES.events)
  .select("id,title,slug,excerpt,event_date,venue,location")
  .eq("is_published", true)
  .gte("event_date", new Date().toISOString())
  .order("event_date", { ascending: true })
  .limit(3)
  : { data: null };

const articles = news ?? [];
const upcomingEvents = events ?? [];
---
<BaseLayout>
  <Hero title={site.headline} subtitle={site.tagline} />

  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="text-[#5B9BD5] text-sm font-bold uppercase tracking-widest mb-2">Newsroom</div>
        <h2 class="text-3xl font-bold text-slate-900">Latest News</h2>
      </div>
      <a href="/news" class="text-[#5B9BD5] font-semibold text-sm hover:underline hidden sm:block">View All News &rarr;</a>
    </div>
    {articles.length > 0 ? (
      <ul class="grid md:grid-cols-3 gap-6">
        {articles.map(p => (
          <li class="border border-slate-200 rounded-2xl bg-white hover:shadow-lg transition-all duration-200 overflow-hidden group">
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-bold text-[#5B9BD5] bg-[#5B9BD5]/10 px-2.5 py-1 rounded-full uppercase tracking-widest">{p.category}</span>
                <span class="text-slate-400 text-xs">{new Date(p.published_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
              </div>
              <h3 class="font-bold text-slate-900 text-lg leading-snug mb-2 group-hover:text-[#5B9BD5] transition-colors">
                <a href={`/news/${p.slug}`}>{p.title}</a>
              </h3>
              {p.excerpt && <p class="text-slate-500 text-sm leading-relaxed line-clamp-3">{p.excerpt}</p>}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <div class="text-center py-12 border border-dashed border-slate-300 rounded-2xl">
        <p class="text-slate-400 font-medium">No news articles yet. Check back soon.</p>
      </div>
    )}
    <div class="mt-6 text-center sm:hidden">
      <a href="/news" class="text-[#5B9BD5] font-semibold text-sm hover:underline">View All News &rarr;</a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="text-[#5B9BD5] text-sm font-bold uppercase tracking-widest mb-2">Calendar</div>
        <h2 class="text-3xl font-bold text-slate-900">Upcoming Events</h2>
      </div>
      <a href="/events" class="text-[#5B9BD5] font-semibold text-sm hover:underline hidden sm:block">View All Events &rarr;</a>
    </div>
    {upcomingEvents.length > 0 ? (
      <div class="space-y-4">
        {upcomingEvents.map(e => {
          const eventDate = new Date(e.event_date);
          return (
            <a href={`/events/${e.slug}`} class="group flex items-stretch bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md hover:border-slate-300 transition-all duration-200">
              <div class="w-20 flex-shrink-0 flex flex-col items-center justify-center p-4 bg-slate-900">
                <span class="text-xs font-bold uppercase tracking-widest text-[#5B9BD5]">
                  {eventDate.toLocaleDateString("en-US", { month: "short" })}
                </span>
                <span class="text-3xl font-black leading-none text-white">
                  {eventDate.getDate()}
                </span>
                <span class="text-xs font-medium text-slate-400">
                  {eventDate.getFullYear()}
                </span>
              </div>
              <div class="flex-1 px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div>
                  <h3 class="font-bold text-slate-900 text-lg leading-snug mb-1 group-hover:text-[#5B9BD5] transition-colors">{e.title}</h3>
                  {e.excerpt && <p class="text-slate-500 text-sm leading-relaxed line-clamp-2">{e.excerpt}</p>}
                  {(e.venue || e.location) && (
                    <div class="flex items-center gap-1 mt-2">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span class="text-slate-400 text-xs">{[e.venue, e.location].filter(Boolean).join(", ")}</span>
                    </div>
                  )}
                </div>
                <svg class="w-5 h-5 text-slate-300 group-hover:text-[#5B9BD5] group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-12 border border-dashed border-slate-300 rounded-2xl">
        <p class="text-slate-400 font-medium">No upcoming events scheduled. Check back soon.</p>
      </div>
    )}
    <div class="mt-6 text-center sm:hidden">
      <a href="/events" class="text-[#5B9BD5] font-semibold text-sm hover:underline">View All Events &rarr;</a>
    </div>
  </section>

  <SupporterStrip />
</BaseLayout>
