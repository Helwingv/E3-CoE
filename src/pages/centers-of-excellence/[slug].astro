---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
import { coes, type CoE } from "../../config/coes";

export function getStaticPaths() {
  return coes.map((coe) => ({ params: { slug: coe.slug }, props: { coe } }));
}

const { coe } = Astro.props as { coe: CoE };
const others = coes.filter((c) => c.slug !== coe.slug);
---

<BaseLayout
  title={`${coe.name} | Centers Of Excellence | ${site.name}`}
  description={`${coe.line}: the E3 CoE ${coe.name} Center Of Excellence.`}
>
  <section class="bg-gradient-to-br from-e3-900 via-e3-800 to-e3-700 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-20 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-sm font-semibold tracking-widest text-e3-200 uppercase">
          <a href="/centers-of-excellence" class="hover:text-white">Centers Of Excellence (CoEs)</a>
        </p>
        <h1 class="mt-3 text-3xl md:text-5xl font-extrabold leading-tight">{coe.name}</h1>
        <p class="mt-6 text-lg md:text-xl text-white border-l-4 border-e3 pl-4 italic">{coe.line}</p>
      </div>
      <div class="lg:col-span-5">
        {coe.image ? (
          <img src={coe.image} alt={coe.name} width="1600" height="1000" class="w-full aspect-[16/10] rounded-2xl object-cover shadow-lg" />
        ) : (
          <div class="aspect-[16/10] rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center">
            <img src={site.logos.large} alt={site.fullName} width="220" height="220" class="h-40 w-40 md:h-48 md:w-48 rounded-full bg-white p-2 shadow-lg" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    {coe.body.length > 0 ? (
      <div class="space-y-6 text-lg text-gray-700 leading-relaxed">
        {coe.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    ) : (
      <div class="rounded-2xl bg-e3-50 border border-e3-200 p-8">
        <h2 class="text-xl font-bold text-e3-900">More about this Center Of Excellence is coming soon.</h2>
        <p class="mt-3 text-gray-700">
          To learn more now, contact us at
          <a class="underline" href={`tel:${site.phone.replace(/[^0-9]/g, "")}`}>{site.phone}</a> or
          <a class="underline" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    )}

    <div class="mt-12 flex flex-wrap gap-3">
      {others.map((c) => (
        <a href={`/centers-of-excellence/${c.slug}`} class="rounded-md border-2 border-e3 px-4 py-2 text-sm font-semibold text-e3-900 hover:bg-e3 hover:text-white transition">
          {c.name} →
        </a>
      ))}
      <a href="/about/make-a-difference" class="rounded-md bg-e3-700 px-4 py-2 text-sm font-semibold text-white hover:bg-e3-800 transition">
        Make A Difference →
      </a>
    </div>
  </section>
</BaseLayout>
