---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";

/**
 * Hero image for this page.
 * Put the file in public/images/ (landscape 3:2, WebP) and set its path
 * here, e.g. "/images/who-we-are-hero.jpg". Until then the hero shows the logo.
 */
const heroImage: string | undefined = undefined;
const heroImageAlt = "Education, business and infrastructure arrows rising over a city at night";

const about = [
  "The Smith Gruppe E3 CoE (Center of Excellence) model, established in 2022, champions a transformative vision for marginalized, underserved, and underrepresented communities. Guided by the bold ethos of a “Relentless Pursuit of Excellence,” we empower individuals and stakeholders to reclaim their narratives and define their destinies. Through education, economic development, and entrepreneurship, we ignite pathways to lasting economic and social sustainability.",
  "Our approach is grounded in technology-driven innovation and collaboration, fueling opportunities that transcend barriers and unlock potential. Each E3 CoE is supported by a Smith Gruppe IEDC (Infrastructure Edge Data Center), which makes it more than a center—it’s a movement. Our team is the “Difference Maker,” and the catalyst for groundbreaking ideas that ripple across the social sphere, uniting diverse voices and amplifying the impact of community-based initiatives.",
  "Every year, our mission inspires a growing coalition of philanthropists, volunteers, corporate leaders, higher education institutions, public agencies, and private sector organizations. Their dedication affirms a universal truth: that change is possible when we commit resources, capacity, and care to create sustainable, thriving communities.",
  "We stand united in purpose, daring to dream of a future where education empowers, economic development uplifts, and entrepreneurship transforms. Together, we build a legacy of resilience, innovation, equity, and sustainability—one community at a time."
];
---

<BaseLayout
  title={`Who We Are | ${site.name}`}
  description="E3 CoE is an Economic Empowerment Organization: Enabling Through Education, Empowering Through Entrepreneurship, And Driving Change Through Economic Development."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-e3-900 via-e3-800 to-e3-700 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-20 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-sm font-semibold tracking-widest text-e3-200 uppercase">Who We Are</p>
        <h1 class="mt-3 text-3xl md:text-5xl font-extrabold leading-tight">
          We Are An Economic Empowerment Organization
        </h1>
        <p class="mt-6 text-lg md:text-xl text-white border-l-4 border-e3 pl-4 italic leading-relaxed">
          “{site.tagline}”
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/about/make-a-difference"
            class="inline-flex items-center justify-center rounded-md bg-e3 px-5 py-3 text-sm font-semibold text-white hover:bg-e3-600 transition"
          >
            Make A Difference →
          </a>
          <a
            href="/about/board-and-team"
            class="inline-flex items-center justify-center rounded-md border-2 border-white px-5 py-3 text-sm font-semibold text-white hover:bg-white hover:text-e3-900 transition"
          >
            Meet Our Leadership
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        {heroImage ? (
          <img
            src={heroImage}
            alt={heroImageAlt}
            width="1536"
            height="1024"
            fetchpriority="high"
            class="w-full aspect-[3/2] rounded-2xl object-cover shadow-lg border-4 border-white/20"
          />
        ) : (
          <div class="aspect-[16/10] rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center">
            <img
              src={site.logos.large}
              alt={site.fullName}
              width="220"
              height="220"
              class="h-44 w-44 md:h-52 md:w-52 rounded-full bg-white p-2 shadow-lg"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="mx-auto max-w-4xl px-4 py-16">
    <p class="text-e3-700 text-sm font-bold uppercase tracking-widest">The E3 CoE (Centers of Excellence)</p>
    <h2 class="mt-2 text-2xl md:text-4xl font-bold text-e3-900">Driving Change, Building Sustainability</h2>
    <div class="mt-8 space-y-6 text-lg text-gray-700 leading-relaxed">
      {about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-4">
    <div class="rounded-2xl bg-e3-50 border border-e3-200 border-t-4 border-t-e3 p-8 md:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <h2 class="text-2xl font-bold text-e3-900">Be A Difference Maker</h2>
        <p class="text-gray-700 mt-2 max-w-2xl">
          Donate, invest, volunteer, or partner with the E3 CoE.
        </p>
      </div>
      <a
        href="/about/make-a-difference"
        class="inline-flex items-center justify-center rounded-md bg-e3-700 px-6 py-3 text-sm font-semibold text-white hover:bg-e3-800 transition"
      >
        Make A Difference →
      </a>
    </div>
  </section>
</BaseLayout>
