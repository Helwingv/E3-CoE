---
import PageLayout from "../../layouts/PageLayout.astro";
import Card from "../../components/Card.astro";
---

<PageLayout title="Get Involved" intro="Join us in building a more equitable community.">
  <section class="mx-auto max-w-7xl px-4 py-12 space-y-16">

    <!-- Hero -->
    <section class="grid gap-8 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
          Get Involved
        </p>

        <h1 class="mt-3 text-3xl md:text-5xl font-extrabold leading-tight">
          Be Part of the Work That Builds Stronger Economies
        </h1>

        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          Economic transformation requires committed partners. Whether you lead, fund, build, or serve—we invite you to join us.
        </p>

        <div class="mt-6">
          <a
            href="#ways"
            class="inline-flex items-center justify-center rounded-md bg-[#5B9BD5] px-5 py-3 text-sm font-semibold text-white hover:opacity-90 transition"
          >
            Start Your Engagement →
          </a>
        </div>

        <p class="mt-4 text-xs text-gray-500">
          Image suggestions: board and committee collaboration, community roundtables,
          volunteers and partners in action.
        </p>
      </div>

      <div class="lg:col-span-5">
        <Card padding="md">
          <div class="aspect-[16/10] rounded-md bg-gray-100 flex items-center justify-center text-sm text-gray-500">
            Engagement image placeholder
          </div>
          <p class="mt-3 text-sm text-gray-600">
            Swap in collaboration and community visuals when ready.
          </p>
        </Card>
      </div>
    </section>

    <!-- Ways to Engage -->
    <section id="ways">
      <h2 class="text-2xl font-bold mb-6">Ways to Engage</h2>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">

        <Card padding="md">
          <h3 class="font-semibold">Board &amp; Committee Service</h3>
          <p class="text-sm text-gray-600 mt-2">
            Shape strategy and steward long-term impact.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Public &amp; Private Partnerships</h3>
          <p class="text-sm text-gray-600 mt-2">
            Align initiatives with measurable outcomes.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Philanthropy &amp; Investment</h3>
          <p class="text-sm text-gray-600 mt-2">
            Fuel scalable, accountable economic growth.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Community Collaboration</h3>
          <p class="text-sm text-gray-600 mt-2">
            Co-create solutions that reflect local realities.
          </p>
        </Card>

      </div>
    </section>

    <!-- Trust & Transparency -->
    <section>
      <h2 class="text-2xl font-bold mb-6">Trust &amp; Transparency</h2>

      <div class="grid gap-6 md:grid-cols-3">
        <Card padding="md">
          <h3 class="font-semibold">IRS-compliant systems</h3>
          <p class="text-sm text-gray-600 mt-2">
            Donation and reporting aligned with compliance best practices.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Board oversight &amp; ethics policies</h3>
          <p class="text-sm text-gray-600 mt-2">
            Governance designed for accountability and integrity.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Transparent stewardship</h3>
          <p class="text-sm text-gray-600 mt-2">
            Financial practices built to earn trust and sustain impact.
          </p>
        </Card>
      </div>
    </section>

    <!-- Final CTA (High Contrast / Sticky-ish) -->
    <section class="sticky bottom-0 z-40">
      <div class="py-4">
        <div class="rounded-xl bg-charcoal text-white px-6 py-5 shadow-lg flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h2 class="text-lg md:text-xl font-bold">
              Join the Pursuit of Excellence
            </h2>
            <p class="text-sm text-white/80 mt-1">
              Step into partnership, service, or support—move the work forward with us.
            </p>
          </div>

          <a
            href="#"
            class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-semibold text-charcoal hover:opacity-90 transition"
          >
            Join the Pursuit of Excellence →
          </a>
        </div>
      </div>
    </section>

  </section>
</PageLayout>
