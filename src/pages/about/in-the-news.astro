---
import PageLayout from "../../layouts/PageLayout.astro";
import Card from "../../components/Card.astro";
import SectionHeading from "../../components/SectionHeading.astro";
---

<PageLayout title="In the News" intro="Recent media coverage and press releases.">
  <section class="mx-auto max-w-7xl px-4 py-12 space-y-16">

    <!-- Hero -->
    <section class="grid gap-8 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
          In the News
        </p>

        <h1 class="mt-3 text-3xl md:text-5xl font-extrabold leading-tight">
          Thought Leadership Shaping the Future of Economic Development
        </h1>

        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          E3 CoE is planning for a Thought Leadership Symposium in April of 2026.
        </p>

        <p class="mt-3 text-base text-gray-700 leading-relaxed">
          Insights, announcements, and perspectives from the front lines of growth, policy, and execution.
        </p>

        <div class="mt-6">
          <a
            href="#latest"
            class="inline-flex items-center justify-center rounded-md bg-[#5B9BD5] px-5 py-3 text-sm font-semibold text-white hover:opacity-90 transition"
          >
            Read the Latest →
          </a>
        </div>

        <p class="mt-4 text-xs text-gray-500">
          Image suggestions: editorial-style leadership photos, event panels and keynote moments,
          publication mockups (newsletter, reports).
        </p>
      </div>

      <div class="lg:col-span-5">
        <Card padding="sm">
          <div class="aspect-[16/10] rounded-md bg-gray-100 flex items-center justify-center text-sm text-gray-500">
            Hero image / media montage placeholder
          </div>
          <p class="mt-3 text-sm text-gray-600">
            Swap in press imagery, symposium visuals, or publication mockups.
          </p>
        </Card>
      </div>
    </section>

    <!-- Content Blocks -->
    <section id="latest">
      <SectionHeading>Content</SectionHeading>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <Card href="/news/press-releases" padding="md" class="group">
          <h3 class="font-semibold group-hover:text-brand transition">
            Press Releases
          </h3>
          <p class="text-sm text-gray-600 mt-2">
            Organizational announcements and milestones.
          </p>
          <p class="text-xs text-gray-500 mt-3">View releases →</p>
        </Card>

        <Card href="/news/growth-intelligence-brief" padding="md" class="group">
          <h3 class="font-semibold group-hover:text-brand transition">
            Growth Intelligence Brief
          </h3>
          <p class="text-sm text-gray-600 mt-2">
            Monthly thought leadership publication.
          </p>
          <p class="text-xs text-gray-500 mt-3">Read the brief →</p>
        </Card>

        <Card href="/news/media-features" padding="md" class="group">
          <h3 class="font-semibold group-hover:text-brand transition">
            Media Features &amp; Op-Eds
          </h3>
          <p class="text-sm text-gray-600 mt-2">
            National and regional perspectives.
          </p>
          <p class="text-xs text-gray-500 mt-3">Explore features →</p>
        </Card>

        <Card href="/news/reports-white-papers" padding="md" class="group">
          <h3 class="font-semibold group-hover:text-brand transition">
            Reports &amp; White Papers
          </h3>
          <p class="text-sm text-gray-600 mt-2">
            Data-driven insights for decision-makers.
          </p>
          <p class="text-xs text-gray-500 mt-3">View reports →</p>
        </Card>
      </div>
    </section>

    <!-- Social Proof / Validation -->
    <section>
      <SectionHeading>Social Proof</SectionHeading>

      <div class="grid gap-6 md:grid-cols-3">
        <Card padding="md">
          <h3 class="font-semibold">Featured in regional and national outlets</h3>
          <p class="text-sm text-gray-600 mt-2">
            Coverage and distribution expanding as initiatives scale.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Trusted voice across sectors</h3>
          <p class="text-sm text-gray-600 mt-2">
            Respected among public-sector and private-sector leaders.
          </p>
        </Card>

        <Card padding="md">
          <h3 class="font-semibold">Cited for governance &amp; execution</h3>
          <p class="text-sm text-gray-600 mt-2">
            Recognized for accountability, innovation, and outcomes-first leadership.
          </p>
        </Card>
      </div>
    </section>

    <!-- CTA -->
    <section>
      <Card padding="lg">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div>
            <h2 class="text-2xl font-bold">Subscribe to Growth Intelligence Brief</h2>
            <p class="text-gray-700 mt-2 max-w-2xl">
              Get monthly insights and updates on growth strategy, governance, and execution—delivered to your inbox.
            </p>
          </div>

          <a
            href="#"
            class="inline-flex items-center justify-center rounded-md bg-[#5B9BD5] px-6 py-3 text-sm font-semibold text-white hover:opacity-90 transition"
          >
            Subscribe →
          </a>
        </div>

        <p class="mt-3 text-xs text-gray-500">
          Replace <code>#</code> with your newsletter signup link (HubSpot form, mailing list, etc.).
        </p>
      </Card>
    </section>

  </section>
</PageLayout>
