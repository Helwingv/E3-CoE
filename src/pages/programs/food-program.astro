---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout title="Food Program — Vision 8:28" description="Vision 8:28 and The Outreach Farm join forces to feed economically challenged families across the Grand Strand. Every meal is relief, dignity, hope, and stability.">
  <div class="bg-white">

    <!-- HERO -->
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-20 md:py-28 overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0 bg-[url('/images/pexels-wesleydavi-25947215.jpg')] bg-cover bg-center"></div>
      </div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center gap-12">
          <div class="flex-1 max-w-2xl">
            <span class="inline-block text-xs font-semibold uppercase tracking-wide text-white bg-growth-green px-4 py-1.5 rounded-full mb-6">Launching June 24, 2026</span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
              "When Did I See You An Hungred..." Food Program
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-6">
              A powerful partnership between Vision 8:28 and The Outreach Farm to feed families, restore dignity, and build hope across the Grand Strand.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="https://donate.stripe.com/28E14m9o6ccJ7Ns8dZaVa00"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-growth-green text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#2e8c59] transition-colors duration-200 shadow-lg text-center"
              >
                Donate To Feed Families
              </a>
              <a
                href="#about-program"
                class="inline-block border-2 border-white/60 hover:border-white text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors duration-200 text-center"
              >
                Learn More
              </a>
            </div>
          </div>
          <div class="flex-1 flex justify-center">
            <img
              src="/images/Facebook_Story.png"
              alt="When Did I See You An Hungred Food Program"
              class="rounded-2xl shadow-2xl max-h-[480px] w-auto object-contain"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- THE PROBLEM -->
    <section id="about-program" class="py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold tracking-widest uppercase text-growth-green mb-3">The Challenge</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            No One Should Face Hunger Alone
          </h2>
          <p class="text-xl text-gray-700 leading-relaxed max-w-3xl mx-auto">
            Across the Grand Strand, too many families are making impossible choices between paying bills and putting food on the table.
          </p>
        </div>
        <p class="text-lg text-gray-700 leading-relaxed text-center max-w-3xl mx-auto">
          But something powerful happens when a community decides no one should face hunger alone. That's why <strong>Vision 8:28</strong> and <strong>The Outreach Farm</strong> have joined together — combining long-term community transformation with immediate action that feeds families today.
        </p>
      </div>
    </section>

    <!-- WHAT EVERY MEAL MEANS -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <p class="text-sm font-semibold tracking-widest uppercase text-growth-green mb-3">Every Meal Matters</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Every Meal Delivered Is More Than Food
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition-shadow duration-300 text-center">
            <div class="w-14 h-14 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-growth-green font-bold">1</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Relief</h3>
            <p class="text-gray-600">For a struggling parent trying to provide for their family</p>
          </div>
          <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition-shadow duration-300 text-center">
            <div class="w-14 h-14 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-growth-green font-bold">2</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Dignity</h3>
            <p class="text-gray-600">For a senior citizen who deserves care and respect</p>
          </div>
          <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition-shadow duration-300 text-center">
            <div class="w-14 h-14 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-growth-green font-bold">3</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Hope</h3>
            <p class="text-gray-600">For a child who needs nourishment to learn and grow</p>
          </div>
          <div class="bg-white rounded-xl p-8 shadow-md hover:shadow-xl transition-shadow duration-300 text-center">
            <div class="w-14 h-14 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl text-growth-green font-bold">4</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Stability</h3>
            <p class="text-gray-600">For a family trying to survive difficult times</p>
          </div>
        </div>
      </div>
    </section>

    <!-- THE PARTNERSHIP -->
    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center gap-12">
          <div class="flex-1">
            <p class="text-sm font-semibold tracking-widest uppercase text-growth-green mb-3">Our Partnership</p>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
              Vision 8:28 + The Outreach Farm
            </h2>
            <div class="space-y-4 text-gray-700 text-lg leading-relaxed">
              <p>
                <strong>The Outreach Farm</strong> already helps provide more than <span class="text-growth-green font-bold">290,000 meals every year</span> to organizations serving Horry, Georgetown, and Williamsburg counties.
              </p>
              <p>
                <strong>E3 CoE</strong> is working to create pathways toward economic mobility, equity, leadership, and long-term prosperity throughout our region.
              </p>
              <p>
                Together, we believe our community can do more than respond to crisis. <strong>We can build a future where every person has both nourishment and opportunity.</strong>
              </p>
            </div>
          </div>
          <div class="flex-1 flex justify-center">
            <div class="bg-slate-50 rounded-2xl p-10 border border-slate-200 text-center">
              <div class="text-5xl font-bold text-growth-green mb-2">290,000+</div>
              <p class="text-gray-600 text-lg font-medium">Meals provided annually</p>
              <p class="text-sm text-gray-500 mt-2">Serving Horry, Georgetown, and Williamsburg counties</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION & DONATE -->
    <section class="py-20 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Become Part Of The Future
        </h2>
        <p class="text-xl text-slate-300 leading-relaxed max-w-3xl mx-auto mb-4">
          Whether through a one-time gift, recurring support, volunteering, or simply sharing this mission with others — your action matters.
        </p>
        <p class="text-lg text-slate-400 italic mb-4">Because when people are fed, hope grows.</p>
        <p class="text-lg text-slate-400 italic mb-10">And when hope grows, communities rise.</p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
          <div class="flex flex-col items-center gap-4">
            <a
              href="https://donate.stripe.com/28E14m9o6ccJ7Ns8dZaVa00"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-growth-green text-white px-10 py-5 rounded-xl font-bold text-lg hover:bg-[#2e8c59] transition-colors duration-200 shadow-lg"
            >
              Donate To Feed Families
            </a>
            <p class="text-sm text-slate-400">Secure payment via Stripe</p>
          </div>
          <div class="flex flex-col items-center gap-3">
            <p class="text-sm text-slate-400 font-medium">Or scan to donate</p>
            <img
              src="/images/Vision828_HungredBasicDonationQRCode.png"
              alt="Scan QR code to donate to the Food Program"
              class="w-40 h-40 rounded-xl bg-white p-2"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- HOW TO HELP -->
    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <p class="text-sm font-semibold tracking-widest uppercase text-growth-green mb-3">Ways To Help</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Every Action Makes A Difference
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="border border-gray-200 rounded-xl p-6 text-center hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-growth-green font-bold text-lg">$</span>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">One-Time Gift</h3>
            <p class="text-sm text-gray-600">Any amount makes an immediate difference for a family in need</p>
          </div>
          <div class="border border-gray-200 rounded-xl p-6 text-center hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-growth-green font-bold text-lg">&#x21BB;</span>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Recurring Support</h3>
            <p class="text-sm text-gray-600">Monthly giving ensures consistent, reliable food access for families</p>
          </div>
          <div class="border border-gray-200 rounded-xl p-6 text-center hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-growth-green font-bold text-lg">&#x2764;</span>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Volunteer</h3>
            <p class="text-sm text-gray-600">Give your time to help sort, pack, and deliver meals to neighbors</p>
          </div>
          <div class="border border-gray-200 rounded-xl p-6 text-center hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-growth-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-growth-green font-bold text-lg">&#x21E8;</span>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Share The Mission</h3>
            <p class="text-sm text-gray-600">Spread the word to help us reach more people who want to make a difference</p>
          </div>
        </div>
      </div>
    </section>

    <StickyCTA
      title="Feed A Family Today"
      description="Your donation provides immediate relief and long-term hope for families across the Grand Strand."
      ctaText="Donate Now"
      ctaHref="https://donate.stripe.com/28E14m9o6ccJ7Ns8dZaVa00"
    />
  </div>
</BaseLayout>
