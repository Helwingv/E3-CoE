---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout
  title="Small Business & EDCs | Programs | E3 CoE"
  description="We equip small businesses and Economic Development Corporations with the tools, intelligence, and partnerships needed to grow sustainably."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Strengthening the Backbone of Local Economies
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              We equip small businesses and Economic Development Corporations with the tools, intelligence, and partnerships needed to grow sustainably. It's all about building and scaling capacity and resources.
            </p>
          </div>
          <a
            href="#resources"
            class="inline-block bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
          >
            Access Resources
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            The Pain Point
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed mb-4">
            Small businesses and EDCs are expected to do more—with fewer resources and rising complexity.
          </p>
          <p class="text-2xl font-semibold text-slate-900">
            We build capacity where it matters most.
          </p>
          <p class="text-lg text-slate-600 mt-4">
            Starting with strong Strategic and Resource Partner relations.
          </p>
        </div>
      </div>
    </section>

    <section id="resources" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            What We Provide
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Comprehensive support designed to help you succeed
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Strategic Advisory & Capacity-Building
                </h3>
                <p class="text-slate-600 mb-4">
                  → Better planning, stronger execution
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Expert guidance to strengthen your organizational capacity, refine strategic direction, and build sustainable operational frameworks.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Access to Capital Pathways
                </h3>
                <p class="text-slate-600 mb-4">
                  → Readiness for funding and growth
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Navigate federal, state, and private funding opportunities with expert support on application readiness and compliance.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Growth Intelligence Tools (IEDCs)
                </h3>
                <p class="text-slate-600 mb-4">
                  → Smarter decisions, reduced risk
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Infrastructure Edge Data Centers provide real-time market intelligence and analytics to inform strategic decisions and reduce investment risk.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#5B9BD5] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Peer & Partner Networks
                </h3>
                <p class="text-slate-600 mb-4">
                  → Shared learning and collaboration
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Connect with fellow practitioners, share best practices, and collaborate on regional initiatives that multiply impact.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Trust Signals
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-[#5B9BD5] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Designed for Federal & State Alignment
            </h3>
            <p class="text-slate-600">
              Our frameworks align with federal and state priorities, ensuring compliance and maximizing funding opportunities.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#5B9BD5] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Built by Practitioners, Not Theorists
            </h3>
            <p class="text-slate-600">
              Real-world experience informs every tool, resource, and framework we provide to your organization.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#5B9BD5] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Scalable & Replicable Frameworks
            </h3>
            <p class="text-slate-600">
              Proven models that can be adapted and scaled to meet the unique needs of any community or region.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h3 class="text-3xl font-bold mb-4">
          Ready to Strengthen Your Economic Development Capacity?
        </h3>
        <p class="text-slate-300 text-lg mb-8">
          Connect with our team to learn how we can support your growth and sustainability goals.
        </p>
        <a
          href="/contact"
          class="inline-block bg-[#5B9BD5] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
        >
          Support Small Business Growth
        </a>
      </div>
    </section>

    <StickyCTA
      title="Partner With E3 CoE"
      description="Join us in delivering measurable economic outcomes for communities across the region."
      ctaText="Partner With E3 CoE"
      ctaHref="/partnership/join"
    />
  </div>
</BaseLayout>
