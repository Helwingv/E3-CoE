---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout
  title="Local & Regional | Programs | Vision 8:28"
  description="We increase the economic viability of local and regional economies and help them compete nationally while remaining grounded in the communities they serve."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Economic Development That Scales—Without Losing Local Soul
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              We increase the economic viability of local and regional economies and help them compete nationally while remaining grounded in the communities they serve.
            </p>
          </div>
          <a
            href="#initiatives"
            class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
          >
            View Regional Initiatives
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            Overcoming The Challenge
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed mb-4">
            Local economies are asked to compete globally—often without the strategy, data, or coordination needed to scale effectively.
          </p>
          <p class="text-2xl font-semibold text-slate-900">
            Vision 8:28 closes that gap.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-[#24a4b9] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              Regional growth strategies
            </h3>
            <p class="text-slate-600">
              → Alignment across municipalities and counties
            </p>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-[#24a4b9] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              Industry cluster development
            </h3>
            <p class="text-slate-600">
              → Stronger ecosystems, not isolated wins
            </p>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-[#24a4b9] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              Infrastructure and workforce alignment
            </h3>
            <p class="text-slate-600">
              → Growth supported by talent, systems, and project pipelines
            </p>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="w-12 h-12 bg-[#24a4b9] bg-opacity-10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              Public–private execution models
            </h3>
            <p class="text-slate-600">
              → Often Through PPPs (Public Private Partnerships)<br />
              → Faster progress with shared accountability
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="initiatives" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            Proven Regional Impact
          </h2>
          <p class="text-xl text-slate-600 max-w-3xl mx-auto">
            We deliver measurable results through strategic coordination and shared commitment.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl p-8 text-center shadow-sm">
            <div class="text-4xl font-bold text-[#24a4b9] mb-2">Multiple</div>
            <div class="text-slate-600 font-medium">Regional collaborations formed</div>
          </div>
          <div class="bg-white rounded-xl p-8 text-center shadow-sm">
            <div class="text-4xl font-bold text-[#24a4b9] mb-2">Growing</div>
            <div class="text-slate-600 font-medium">Cross-jurisdiction initiatives executed</div>
          </div>
          <div class="bg-white rounded-xl p-8 text-center shadow-sm">
            <div class="text-4xl font-bold text-[#24a4b9] mb-2">Enhanced</div>
            <div class="text-slate-600 font-medium">Economic resilience strengthened</div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <a
          href="/contact"
          class="inline-block bg-[#24a4b9] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
        >
          Partner With Us Regionally
        </a>
      </div>
    </section>

    <StickyCTA
      title="Partner With Vision 8:28"
      description="Join us in delivering measurable economic outcomes for communities across the region."
      ctaText="Partner With Vision 8:28"
      ctaHref="/partnership/join"
    />
  </div>
</BaseLayout>
