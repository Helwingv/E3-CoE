---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout
  title="Advocacy & Thought Leadership | Programs | Vision 8:28"
  description="We elevate the conversation—and inform action—through research, insight, and disciplined advocacy."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Shaping the Future of Economic Development
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              We elevate the conversation—and inform action—through research, insight, and disciplined advocacy.
            </p>
          </div>
          <a
            href="#insights"
            class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
          >
            Explore Our Insights
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            The Opportunity
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed mb-4">
            Economic development policy must evolve as fast as the economy itself in order to break down silos.
          </p>
          <p class="text-2xl font-semibold text-slate-900">
            We help leaders stay ahead.
          </p>
        </div>
      </div>
    </section>

    <section id="insights" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Our Thought Leadership Includes
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Research, analysis, and convening that moves the needle
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Growth Intelligence Brief
                </h3>
                <p class="text-slate-600 mb-4">
                  → Monthly insights at the intersection of policy, capital, and execution
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Timely analysis that connects federal policy, funding opportunities, and practical implementation strategies for economic development leaders.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  White Papers & Reports
                </h3>
                <p class="text-slate-600 mb-4">
                  → Data-driven analysis for decision-makers
                </p>
                <p class="text-slate-600 leading-relaxed">
                  In-depth research reports that provide actionable intelligence on emerging trends, policy implications, and investment opportunities.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Convenings & Panels
                </h3>
                <p class="text-slate-600 mb-4">
                  → Bringing sectors together to move forward
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Strategic gatherings that bridge public, private, and nonprofit sectors to foster collaboration and accelerate regional economic progress.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-[#24a4b9] bg-opacity-10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3">
                  Advocacy with Integrity
                </h3>
                <p class="text-slate-600 mb-4">
                  → Nonpartisan, outcomes-focused perspectives
                </p>
                <p class="text-slate-600 leading-relaxed">
                  Evidence-based advocacy that transcends political divides, focused on sustainable economic outcomes and community prosperity.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Validation
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-[#24a4b9] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Trusted by Public & Private Leaders
            </h3>
            <p class="text-slate-600">
              Our analysis and insights inform decision-making across government agencies, private sector organizations, and community institutions.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#24a4b9] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Cited for Governance & Execution Excellence
            </h3>
            <p class="text-slate-600">
              Our work is recognized for bridging the gap between policy vision and practical implementation with measurable results.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-[#24a4b9] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900 mb-2 text-lg">
              Recognized for Clarity in Complex Environments
            </h3>
            <p class="text-slate-600">
              We distill complexity into actionable insights, helping leaders navigate uncertainty with confidence and clarity.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h3 class="text-3xl font-bold mb-4">
          Ready to Stay Ahead of the Curve?
        </h3>
        <p class="text-slate-300 text-lg mb-8">
          Join leaders who are shaping the future of economic development through informed, strategic action.
        </p>
        <a
          href="/contact"
          class="inline-block bg-[#24a4b9] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
        >
          Join the Growth Intelligence Network
        </a>
      </div>
    </section>

    <StickyCTA
      title="Partner With Vision 8:28"
      description="Join us in delivering measurable economic outcomes for communities across the region."
      ctaText="Partner With Vision 8:28"
      ctaHref="/partnership/join"
    />
  </div>
</BaseLayout>
