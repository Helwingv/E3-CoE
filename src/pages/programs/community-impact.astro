---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout title="Community Impact - E3 CoE">
  <div class="bg-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-20 md:py-28">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0 bg-[url('/images/pexels-wesleydavi-25947215.jpg')] bg-cover bg-center"></div>
      </div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
            E3 CoE Turns Community and Stakeholder Investment Into Measurable Community Impact
          </h1>
          <div class="mb-8">
            <h2 class="text-xl md:text-2xl font-semibold mb-4 text-slate-200">Our Approach</h2>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              We design and deliver programs that convert funding, partnerships, and policy into tangible economic outcomes for people and places.
            </p>
          </div>
          <a
            href="#impact"
            class="inline-block bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
          >
            Explore Our Impact
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            E3 CoE Eliminates Pain Points
          </h2>
          <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
            Too often, well-funded initiatives fail to translate into lived economic progress. Communities need more than programs (Programming For The Sake Of Programming) — our primary objective is to produce outcomes you can see, feel, and sustain.
          </p>
        </div>
      </div>
    </section>

    <section id="impact" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Value Proposition & Benefits
          </h2>
          <p class="text-xl text-gray-600">Our Community Impact programs deliver:</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
          <div class="bg-gradient-to-br from-slate-50 to-white p-8 rounded-xl shadow-md hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-[#5B9BD5] rounded-lg flex items-center justify-center text-white font-bold text-xl">
                →
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  Outcome-driven program design
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  Clear metrics tied to jobs, income, and business growth
                </p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-slate-50 to-white p-8 rounded-xl shadow-md hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-[#5B9BD5] rounded-lg flex items-center justify-center text-white font-bold text-xl">
                →
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  Place-based implementation
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  Solutions tailored to local realities of education, business, and industry, not generic models
                </p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-slate-50 to-white p-8 rounded-xl shadow-md hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-[#5B9BD5] rounded-lg flex items-center justify-center text-white font-bold text-xl">
                →
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  Cross-sector coordination
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  Government, industry, education, and community aligned initiatives
                </p>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-slate-50 to-white p-8 rounded-xl shadow-md hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-[#5B9BD5] rounded-lg flex items-center justify-center text-white font-bold text-xl">
                →
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                  Continuous evaluation and refinement
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  Programs evolve and adapt as conditions change
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-900 text-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Validation And Proof Points Of The E3 CoE Business Model
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
          <div class="text-center">
            <div class="text-4xl font-bold mb-2 text-slate-200">Multi-stakeholder</div>
            <p class="text-slate-400">initiatives launched</p>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold mb-2 text-slate-200">Federal & philanthropic</div>
            <p class="text-slate-400">dollars leveraged</p>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold mb-2 text-slate-200">Workforce & business</div>
            <p class="text-slate-400">outcomes tracked</p>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold mb-2 text-slate-200">Community trust</div>
            <p class="text-slate-400">built through transparency</p>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-6 text-sm text-slate-400">
          <span>Impact dashboards</span>
          <span>•</span>
          <span>Community testimonials</span>
          <span>•</span>
          <span>Program milestones</span>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <a
          href="/contact"
          class="inline-block bg-[#5B9BD5] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
        >
          See How Impact Is Measured
        </a>
      </div>
    </section>

    <!-- FEATURED: USDA 502 DIRECT HOMEOWNERSHIP PROGRAM -->
    <section class="py-20 bg-[#eef7f5]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-10">
          <span class="inline-block text-xs font-semibold uppercase tracking-wide text-white bg-[#5B9BD5] px-4 py-1.5 rounded-full mb-4">New Homeownership Program</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            USDA 502 Direct First-Time Homebuyers Program
          </h2>
          <p class="text-lg text-gray-700 leading-relaxed">
            Vision 8:28 and the E3 CoE (Center Of Excellence) are partnering to help eligible first-time homebuyers pursue affordable homeownership through the USDA Section 502 Direct Loan Program.
          </p>
        </div>

        <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
          <figure class="mx-auto w-full max-w-md">
            <img
              src="/images/SGE3CoE_USDA502DirectProgramInfographic.png"
              alt="USDA 502 Direct Program infographic from SGE3 CoE"
              class="h-auto w-full rounded-lg shadow-lg"
            />
          </figure>

          <div class="grid gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <h3 class="text-xl font-bold text-gray-900 mb-3">A pathway to ownership</h3>
              <p class="text-gray-700 leading-relaxed">The partnership helps prospective buyers understand the USDA 502 Direct process, prepare for application, and connect with the resources needed to move toward a safe, affordable home.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <h3 class="text-xl font-bold text-gray-900 mb-3">Guidance from start to finish</h3>
              <p class="text-gray-700 leading-relaxed">Vision 8:28 and E3 CoE provide education, readiness support, and coordinated referrals so first-time buyers can make informed decisions throughout the homebuying journey.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <h3 class="text-xl font-bold text-gray-900 mb-3">Community wealth building</h3>
              <p class="text-gray-700 leading-relaxed">Expanding access to homeownership strengthens household stability and creates a foundation for long-term economic mobility across the communities we serve.</p>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-t border-[#c9e3de] pt-8">
          <p class="text-gray-700 max-w-2xl">Program eligibility, loan terms, and approval are determined by USDA Rural Development. Contact us to learn about upcoming first-time homebuyer information sessions and partnership resources.</p>
          <a href="/contact" class="inline-block bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold hover:bg-[#3D7FC1] transition-colors duration-200 shadow-md whitespace-nowrap">Contact Us</a>
        </div>
      </div>
    </section>

    <!-- FEATURED: FOOD PROGRAM -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="inline-block text-xs font-semibold uppercase tracking-wide text-white bg-growth-green px-4 py-1.5 rounded-full mb-4">New Program - Launching June 24, 2026</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            "When Did I See You An Hungred..." Food Program
          </h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            A partnership with The Outreach Farm to feed economically challenged families across the Grand Strand.
          </p>
        </div>
        <div class="flex flex-col md:flex-row items-center gap-10 max-w-4xl mx-auto">
          <div class="flex-shrink-0">
            <img
              src="/images/Facebook_Story.png"
              alt="When Did I See You An Hungred Food Program"
              class="rounded-2xl shadow-xl max-h-[360px] w-auto object-contain"
            />
          </div>
          <div class="flex-1">
            <p class="text-gray-700 text-lg leading-relaxed mb-4">
              Across the Grand Strand, too many families are making impossible choices between paying bills and putting food on the table. Vision 8:28 and The Outreach Farm have joined together to ensure no one faces hunger alone.
            </p>
            <p class="text-gray-700 text-lg leading-relaxed mb-6">
              The Outreach Farm already provides more than <strong>290,000 meals every year</strong> to organizations serving Horry, Georgetown, and Williamsburg counties.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="/programs/food-program"
                class="inline-block bg-growth-green text-white px-8 py-4 rounded-lg font-semibold hover:bg-[#2e8c59] transition-colors duration-200 shadow-md text-center"
              >
                Learn More & Donate
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <StickyCTA
      title="Partner With E3 CoE"
      description="Join us in delivering measurable economic outcomes for communities across the region."
      ctaText="Partner With E3 CoE"
      ctaHref="/partnership/join"
    />
  </div>
</BaseLayout>
