---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
---

<BaseLayout
  title="Join The Movement | Partnership | E3 CoE"
  description="E3 CoE is building a national alliance of leaders committed to economic mobility, workforce transformation, and regional revitalization."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Join The Movement.
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
              This is where collaboration becomes commitment.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#apply"
              class="inline-block bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
            >
              Apply For Partnership
            </a>
            <a
              href="/contact"
              class="inline-block bg-white/10 border border-white/20 text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/20 transition-colors duration-200"
            >
              Speak With A Partnership Advisor
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            Building a National Alliance
          </h2>
          <p class="text-xl text-slate-600 leading-relaxed">
            E3 CoE is building a national alliance of leaders committed to measurable outcomes. Joining means becoming part of a structured, high-performance ecosystem.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 max-w-5xl mx-auto">
          {[
            { label: "Economic Mobility", icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" },
            { label: "Workforce Transformation", icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" },
            { label: "Entrepreneurial Growth", icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
            { label: "Regional Revitalization", icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" },
            { label: "Policy Innovation", icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" }
          ].map(item => (
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 text-center hover:shadow-md transition-shadow duration-200">
              <div class="w-12 h-12 bg-[#5B9BD5] bg-opacity-10 rounded-lg flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-[#5B9BD5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
                </svg>
              </div>
              <span class="text-slate-800 font-semibold text-sm">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            The Membership Process
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            A clear, structured path from interest to impact.
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="relative">
            <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-slate-200 hidden md:block"></div>

            {[
              {
                step: "01",
                title: "Submit Expression of Interest",
                description: "Complete our partnership inquiry form. Tell us about your organization, your mission, and your vision for regional impact."
              },
              {
                step: "02",
                title: "Strategic Alignment Review",
                description: "Our team reviews your submission to assess mission fit, geographic focus, and potential for collaborative outcomes."
              },
              {
                step: "03",
                title: "Partnership Tier Selection",
                description: "Together, we identify the partnership tier that best fits your organization's capacity, goals, and investment level."
              },
              {
                step: "04",
                title: "Onboarding & Public Announcement",
                description: "Welcome to the ecosystem. Your partnership is formalized, announced publicly, and integrated into our collaborative network."
              }
            ].map((item, i) => (
              <div class="relative flex gap-8 mb-10">
                <div class="flex-shrink-0 w-16 h-16 bg-slate-900 text-white rounded-full flex items-center justify-center font-bold text-lg z-10">
                  {item.step}
                </div>
                <div class="bg-white border border-slate-200 rounded-xl p-6 flex-1 shadow-sm">
                  <h3 class="text-xl font-bold text-slate-900 mb-2">{item.title}</h3>
                  <p class="text-slate-600 leading-relaxed">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            What Partners Are Saying
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-8">
            <div class="mb-6">
              <svg class="w-8 h-8 text-[#5B9BD5] opacity-60" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
              </svg>
            </div>
            <p class="text-slate-700 text-lg leading-relaxed mb-6 italic">
              "Partnering with E3 CoE aligned our corporate strategy with measurable community impact."
            </p>
            <div class="border-t border-slate-200 pt-4">
              <p class="font-semibold text-slate-900">Regional Corporate Executive</p>
              <p class="text-slate-500 text-sm">Strategic Partner</p>
            </div>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-xl p-8">
            <div class="mb-6">
              <svg class="w-8 h-8 text-[#5B9BD5] opacity-60" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
              </svg>
            </div>
            <p class="text-slate-700 text-lg leading-relaxed mb-6 italic">
              "Smith Gruppe's E³ CoE helped us scale our economic development strategy beyond traditional models."
            </p>
            <div class="border-t border-slate-200 pt-4">
              <p class="font-semibold text-slate-900">Antoine Smith</p>
              <p class="text-slate-500 text-sm">Chairman & CEO</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="apply" class="py-20 bg-slate-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Apply For Partnership
          </h2>
          <p class="text-lg text-slate-600">
            Ready to commit? Submit your expression of interest and our team will follow up within 48 hours.
          </p>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
          <form class="space-y-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Organization Name</label>
                <input type="text" class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#5B9BD5] focus:border-transparent transition" placeholder="Your organization" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Primary Contact Name</label>
                <input type="text" class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#5B9BD5] focus:border-transparent transition" placeholder="Full name" />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
                <input type="email" class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#5B9BD5] focus:border-transparent transition" placeholder="you@organization.com" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Sector</label>
                <select class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#5B9BD5] focus:border-transparent transition bg-white">
                  <option value="">Select your sector</option>
                  <option>Economic Development</option>
                  <option>Corporate / Private Sector</option>
                  <option>Higher Education</option>
                  <option>Workforce / Labor</option>
                  <option>Public Agency</option>
                  <option>Philanthropy</option>
                  <option>Nonprofit / Community</option>
                  <option>Other</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Partnership Tier of Interest</label>
              <select class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#5B9BD5] focus:border-transparent transition bg-white">
                <option value="">Select a tier</option>
                <option>Founding Partner</option>
                <option>Strategic Partner</option>
                <option>Corporate Partner</option>
                <option>Community Partner</option>
                <option>Institutional Partner</option>
                <option>Not Sure — I'd Like Guidance</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Tell Us About Your Organization & Goals</label>
              <textarea rows="4" class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#5B9BD5] focus:border-transparent transition resize-none" placeholder="Describe your mission, your regional focus, and what you hope to achieve through partnership with E3 CoE..."></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-[#5B9BD5] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#3D7FC1] transition-colors duration-200 shadow-lg"
            >
              Submit Expression of Interest
            </button>
          </form>
        </div>
      </div>
    </section>

    <StickyCTA
      title="Partner With E3 CoE"
      description="Join a national alliance of leaders committed to economic mobility and regional growth."
      ctaText="Apply For Partnership"
      ctaHref="#apply"
    />
  </div>
</BaseLayout>
