---
import BaseLayout from "../layouts/BaseLayout.astro";
import StickyCTA from "../components/StickyCTA.astro";
---

<BaseLayout
  title="Projects | Vision 8:28"
  description="Vision 8:28 projects translate policy, partnership, and planning into measurable economic and community impact."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">

    <!-- HERO -->
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(255,255,255,.05) 60px), repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(255,255,255,.05) 60px);"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 mb-8">
            <div class="w-2 h-2 rounded-full bg-[#24a4b9] animate-pulse"></div>
            <span class="text-sm font-semibold text-white/90 uppercase tracking-widest">Project Portfolio</span>
          </div>
          <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
            Vision In Action.<br />Strategy In Motion.
          </h1>
          <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-3">
            Vision 8:28 projects translate policy, partnership, and planning into measurable economic and community impact.
          </p>
          <p class="text-lg text-[#24a4b9] font-semibold mb-10">
            From regional revitalization to workforce system redesign — built for sustainability, not symbolism.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#active-projects"
              class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
            >
              Explore Active Projects
            </a>
            <a
              href="#inquiry"
              class="inline-block bg-white/10 border border-white/20 text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/20 transition-colors duration-200"
            >
              Submit A Project Inquiry
            </a>
          </div>
        </div>
      </div>
      <!-- decorative stat strip -->
      <div class="absolute bottom-0 left-0 right-0 bg-black/30 border-t border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {[
              { value: "22+", label: "Active Projects" },
              { value: "14", label: "Regional Markets" },
              { value: "$85M+", label: "Capital Influenced" },
              { value: "400+", label: "Partner Organizations" }
            ].map(stat => (
              <div class="text-center">
                <div class="text-2xl font-bold text-[#24a4b9]">{stat.value}</div>
                <div class="text-slate-400 text-xs uppercase tracking-widest mt-1">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED PROJECT -->
    <section class="py-16 bg-white border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-6">Transformational Initiatives</div>
        <div class="bg-slate-900 text-white rounded-2xl overflow-hidden">
          <div class="grid lg:grid-cols-5">
            <div class="lg:col-span-3 p-10 lg:p-14 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-6">
                  <span class="bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full">Active</span>
                  <span class="text-slate-400 text-sm">Multi-County Region</span>
                  <span class="text-slate-600 text-sm">·</span>
                  <span class="text-slate-400 text-sm">Workforce + Industry Growth</span>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold leading-tight mb-6">
                  Regional Workforce Innovation Corridor
                </h2>
                <p class="text-slate-300 text-lg leading-relaxed mb-8">
                  A first-of-its-kind multi-county employer engagement framework connecting industry cluster demand directly to credential-aligned talent pipelines — with shared governance, capital alignment, and quarterly performance accountability.
                </p>
                <blockquote class="border-l-2 border-[#24a4b9] pl-6 mb-8">
                  <p class="text-slate-300 text-lg leading-relaxed italic">
                    "A region grows when its workforce and employers move in alignment. This corridor is proof that alignment is not a theory — it is a design problem we solved together."
                  </p>
                  <footer class="mt-3">
                    <p class="text-white font-semibold text-sm">Executive Director, Vision 8:28</p>
                  </footer>
                </blockquote>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-10">
                  {[
                    { value: "84", label: "Employers Engaged" },
                    { value: "1,200+", label: "Participants" },
                    { value: "91%", label: "Placement Rate" },
                    { value: "$18M", label: "Capital Leveraged" }
                  ].map(m => (
                    <div class="bg-white/5 border border-white/10 rounded-xl p-4 text-center">
                      <div class="text-2xl font-bold text-[#24a4b9]">{m.value}</div>
                      <div class="text-slate-400 text-xs mt-1">{m.label}</div>
                    </div>
                  ))}
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact" class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold hover:bg-[#1d8a9d] transition-colors duration-200">
                  View Full Case Study
                </a>
                <a href="/contact" class="inline-block bg-white/10 border border-white/20 text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/20 transition-colors duration-200">
                  Download Executive Summary
                </a>
              </div>
            </div>
            <div class="lg:col-span-2 bg-slate-800 p-10 flex flex-col justify-center gap-6">
              <h3 class="text-sm font-bold text-white uppercase tracking-widest mb-2">Project Snapshot</h3>
              {[
                { label: "Project Type", value: "Workforce Innovation" },
                { label: "Geography", value: "7-County Corridor" },
                { label: "Duration", value: "36 Months" },
                { label: "Lead Partners", value: "4 EDCs + 2 Universities" },
                { label: "Employer Sectors", value: "Manufacturing, Healthcare, Tech" },
                { label: "Funding Sources", value: "Federal + Private Leveraged" }
              ].map(row => (
                <div class="flex items-start justify-between border-b border-slate-700 pb-4 last:border-0">
                  <span class="text-slate-400 text-sm">{row.label}</span>
                  <span class="text-white text-sm font-medium text-right ml-4">{row.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ACTIVE PROJECTS -->
    <section id="active-projects" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-4">Current Portfolio</div>
          <h2 class="text-4xl font-bold text-slate-900 mb-4">Projects Underway</h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Vision 8:28 operates across four core project domains — each anchored in research, designed for sustainability, and measured for impact.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {[
            {
              number: "01",
              category: "Economic Strategy",
              title: "Regional Economic Strategy Development",
              description: "Comprehensive economic competitiveness plans that align industry clusters, workforce capacity, capital access, and infrastructure modernization into unified, executable regional strategies.",
              focus: ["Industry cluster alignment", "Workforce capacity planning", "Capital access frameworks", "Infrastructure modernization roadmaps"],
              outcomes: ["5-Year Action Plans", "Performance Dashboards", "Public-Private Investment Frameworks"],
              cta: "View Strategy Projects",
              accent: "bg-blue-50 border-blue-200",
              badge: "text-blue-700 bg-blue-100"
            },
            {
              number: "02",
              category: "Small Business",
              title: "Small Business Ecosystem Acceleration",
              description: "Projects focused on building the full entrepreneurial support infrastructure — from capital stack development and procurement readiness to incubator design and accelerator programming.",
              focus: ["Entrepreneurial support systems", "Capital stack development", "Procurement readiness programs", "Incubator & accelerator design"],
              outcomes: ["Increased business formation rates", "Revenue growth metrics", "Capital access expansion"],
              cta: "Explore Small Business Projects",
              accent: "bg-emerald-50 border-emerald-200",
              badge: "text-emerald-700 bg-emerald-100"
            },
            {
              number: "03",
              category: "Workforce",
              title: "Workforce & Talent Alignment Initiatives",
              description: "Modernizing regional workforce systems through structured apprenticeship programs, credential mapping, employer engagement strategy, and career pathway integration across industry sectors.",
              focus: ["Apprenticeship program design", "Credential mapping & portability", "Employer engagement strategy", "Career pathway integration"],
              outcomes: ["Improved placement rates", "Employer pipeline agreements", "Credential framework adoption"],
              cta: "View Workforce Projects",
              accent: "bg-amber-50 border-amber-200",
              badge: "text-amber-700 bg-amber-100"
            },
            {
              number: "04",
              category: "Partnership",
              title: "Public-Private Partnership Structuring",
              description: "Vision 8:28 helps regions architect sustainable partnerships between municipalities, corporations, higher education, and philanthropic institutions — with governance, capital, and accountability frameworks built in.",
              focus: ["Municipal partnership design", "Corporate engagement models", "Higher education integration", "Philanthropic capital alignment"],
              outcomes: ["Governance frameworks", "Capital alignment models", "Performance measurement systems"],
              cta: "Learn About Partnership Projects",
              accent: "bg-slate-50 border-slate-200",
              badge: "text-slate-700 bg-slate-200"
            }
          ].map(project => (
            <div class={`bg-white border ${project.accent} rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col`}>
              <div class="p-8 flex flex-col flex-1">
                <div class="flex items-start justify-between mb-6">
                  <div>
                    <span class={`text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full ${project.badge}`}>{project.category}</span>
                  </div>
                  <span class="text-5xl font-black text-slate-100 leading-none">{project.number}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3 leading-snug">{project.title}</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">{project.description}</p>
                <div class="grid grid-cols-2 gap-6 flex-1">
                  <div>
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Focus Areas</h4>
                    <ul class="space-y-2">
                      {project.focus.map(f => (
                        <li class="flex items-start gap-2">
                          <div class="w-1.5 h-1.5 rounded-full bg-[#24a4b9] flex-shrink-0 mt-1.5"></div>
                          <span class="text-slate-600 text-xs">{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Outcomes</h4>
                    <ul class="space-y-2">
                      {project.outcomes.map(o => (
                        <li class="flex items-start gap-2">
                          <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0 mt-1.5"></div>
                          <span class="text-slate-600 text-xs">{o}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
              <div class="px-8 pb-8 pt-2">
                <a href="/contact" class="block text-center border border-slate-200 text-slate-700 px-4 py-3 rounded-xl font-semibold text-sm hover:border-[#24a4b9] hover:text-[#24a4b9] transition-colors duration-150">
                  {project.cta} →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- COMPLETED PROJECTS -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
          <div>
            <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-3">Project Archive</div>
            <h2 class="text-4xl font-bold text-slate-900 mb-3">Proven Results</h2>
            <p class="text-slate-600 max-w-xl text-lg">
              Completed projects with documented impact, replicable frameworks, and downloadable case studies.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="inline-block bg-[#24a4b9] text-white px-7 py-3 rounded-lg font-semibold text-sm hover:bg-[#1d8a9d] transition-colors duration-200">
              View Project Archive
            </a>
            <a href="/contact" class="inline-block border border-slate-300 text-slate-700 px-7 py-3 rounded-lg font-semibold text-sm hover:border-slate-400 transition-colors duration-200">
              Download Case Study Library
            </a>
          </div>
        </div>

        <div class="space-y-6">
          {[
            {
              title: "Tri-County Economic Revitalization Framework",
              region: "Southeast Region",
              year: "2024",
              type: "Economic Strategy",
              challenge: "Three adjacent counties with fragmented development strategies, competing for the same investment without a unified value proposition.",
              intervention: "Vision 8:28 facilitated a 90-day strategy alignment process, producing a unified regional brand, shared EDC governance model, and coordinated federal funding pipeline.",
              outcomes: [
                { value: "$12M", label: "Federal Grants Secured" },
                { value: "3", label: "Counties Aligned" },
                { value: "18mo", label: "ROI Timeline" }
              ],
              quote: "We had competed against each other for a decade. Vision 8:28 gave us a framework to compete together.",
              attribution: "County Commissioner"
            },
            {
              title: "Advanced Manufacturing Talent Pipeline Initiative",
              region: "Midwest Corridor",
              year: "2023",
              type: "Workforce",
              challenge: "Regional manufacturers facing 34% unfilled skilled trade positions with no coordinated pipeline between employers and training institutions.",
              intervention: "Designed a sector-led apprenticeship consortium connecting 22 employers with 4 community colleges, including shared credential frameworks and co-funded training facilities.",
              outcomes: [
                { value: "22", label: "Employers Engaged" },
                { value: "87%", label: "Placement Rate" },
                { value: "340+", label: "Apprentices Placed" }
              ],
              quote: "The credential framework they designed is now being replicated statewide.",
              attribution: "State Workforce Director"
            },
            {
              title: "Inclusive Small Business Capital Access Program",
              region: "Urban Metro Market",
              year: "2023",
              type: "Small Business",
              challenge: "Minority-owned small businesses in the metro region accessing capital at 40% the rate of comparable non-minority businesses, with no structured intervention mechanism.",
              intervention: "Structured a public-private capital consortium with 6 CDFIs, 3 banks, and 2 municipal programs, creating a coordinated intake, underwriting support, and wraparound service model.",
              outcomes: [
                { value: "6x", label: "Capital Access Increase" },
                { value: "$4.2M", label: "Capital Deployed" },
                { value: "180+", label: "Businesses Served" }
              ],
              quote: "They didn't just connect us to capital — they redesigned the system that was keeping us out.",
              attribution: "CDFI Executive Director"
            }
          ].map(project => (
            <div class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden hover:shadow-md transition-all duration-200">
              <div class="p-8 lg:p-10">
                <div class="flex flex-wrap items-center gap-3 mb-5">
                  <span class="text-xs font-bold text-[#24a4b9] bg-[#24a4b9]/10 px-3 py-1 rounded-full uppercase tracking-widest">{project.type}</span>
                  <span class="text-slate-400 text-sm">{project.region}</span>
                  <span class="text-slate-300">·</span>
                  <span class="text-slate-400 text-sm">Completed {project.year}</span>
                </div>
                <h3 class="text-2xl font-bold text-slate-900 mb-6">{project.title}</h3>
                <div class="grid md:grid-cols-3 gap-8 mb-8">
                  <div>
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Strategic Challenge</h4>
                    <p class="text-slate-600 text-sm leading-relaxed">{project.challenge}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Intervention Approach</h4>
                    <p class="text-slate-600 text-sm leading-relaxed">{project.intervention}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Measured Outcomes</h4>
                    <div class="space-y-3">
                      {project.outcomes.map(o => (
                        <div class="flex items-center gap-3">
                          <span class="text-xl font-bold text-[#24a4b9]">{o.value}</span>
                          <span class="text-slate-500 text-xs">{o.label}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pt-6 border-t border-slate-200">
                  <blockquote class="border-l-2 border-[#24a4b9] pl-4">
                    <p class="text-slate-600 text-sm italic mb-1">"{project.quote}"</p>
                    <footer class="text-slate-400 text-xs font-medium">— {project.attribution}</footer>
                  </blockquote>
                  <a href="/contact" class="flex-shrink-0 inline-block border border-slate-300 text-slate-700 px-6 py-2.5 rounded-lg font-semibold text-sm hover:border-[#24a4b9] hover:text-[#24a4b9] transition-colors duration-150">
                    Download Case Study →
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJECT MAP / FOOTPRINT -->
    <section class="py-20 bg-slate-900 text-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-4">Geographic Reach</div>
          <h2 class="text-4xl font-bold mb-4">Our Footprint</h2>
          <p class="text-slate-300 text-lg max-w-2xl mx-auto">
            Vision 8:28 projects span multiple regional markets — each representing a commitment to structured, measurable economic transformation.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
          {[
            { region: "Southeast Corridor", projects: 8, status: "Active", types: ["Workforce", "Economic Strategy", "PPP"], investment: "$28M" },
            { region: "Midwest Manufacturing Belt", projects: 6, status: "Active", types: ["Workforce", "Small Business"], investment: "$19M" },
            { region: "Urban Metro Markets", projects: 5, status: "Active", types: ["Small Business", "PPP"], investment: "$22M" },
            { region: "Appalachian Growth Zone", projects: 4, status: "Active", types: ["Economic Strategy", "Workforce"], investment: "$11M" },
            { region: "Gulf Coast EDC Network", projects: 3, status: "Active", types: ["PPP", "Economic Strategy"], investment: "$9M" },
            { region: "Mid-Atlantic Innovation Region", projects: 4, status: "Expanding", types: ["Small Business", "Workforce"], investment: "$15M+" }
          ].map(reg => (
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-7 hover:border-[#24a4b9]/50 transition-all duration-200">
              <div class="flex items-start justify-between mb-5">
                <h3 class="font-bold text-white text-lg leading-snug">{reg.region}</h3>
                <span class={`text-xs font-bold px-2.5 py-1 rounded-full whitespace-nowrap ml-3 ${reg.status === "Expanding" ? "bg-amber-400/20 text-amber-400" : "bg-emerald-400/20 text-emerald-400"}`}>
                  {reg.status}
                </span>
              </div>
              <div class="flex items-baseline gap-2 mb-5">
                <span class="text-3xl font-black text-[#24a4b9]">{reg.projects}</span>
                <span class="text-slate-400 text-sm">Projects</span>
                <span class="text-slate-600 mx-2">·</span>
                <span class="text-slate-300 font-semibold text-sm">{reg.investment}</span>
                <span class="text-slate-400 text-xs">influenced</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {reg.types.map(t => (
                  <span class="text-xs text-slate-400 bg-slate-700 px-2.5 py-1 rounded-full">{t}</span>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
          {[
            { value: "6", label: "Active Regions" },
            { value: "30+", label: "Projects Deployed" },
            { value: "$104M+", label: "Total Capital Influenced" },
            { value: "14", label: "Markets Reached" }
          ].map(stat => (
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 text-center">
              <div class="text-3xl font-bold text-[#24a4b9]">{stat.value}</div>
              <div class="text-slate-400 text-xs uppercase tracking-widest mt-2">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- METHODOLOGY -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-4">Our Approach</div>
            <h2 class="text-4xl font-bold text-slate-900 mb-6">Our Methodology</h2>
            <p class="text-lg text-slate-600 leading-relaxed mb-8">
              Every Vision 8:28 project follows a structured lifecycle designed to produce sustainable outcomes — not one-time interventions. Institutional rigor at every phase.
            </p>
            <a
              href="#inquiry"
              class="inline-block bg-[#24a4b9] text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
            >
              Request A Project Consultation
            </a>
          </div>
          <div class="space-y-4">
            {[
              {
                step: "01",
                title: "Assessment & Discovery",
                description: "Data analysis, stakeholder interviews, and economic baseline review to establish a clear-eyed picture of regional conditions, gaps, and opportunities before any strategy is drafted.",
                color: "border-blue-200 bg-blue-50"
              },
              {
                step: "02",
                title: "Strategic Design",
                description: "Policy alignment, capital mapping, and performance metrics creation — translating findings into an executable framework with clear governance and accountability structures.",
                color: "border-emerald-200 bg-emerald-50"
              },
              {
                step: "03",
                title: "Implementation",
                description: "Structured governance, milestone tracking, and stakeholder coordination — ensuring the strategy operates as designed with built-in mechanisms for course correction.",
                color: "border-amber-200 bg-amber-50"
              },
              {
                step: "04",
                title: "Measurement & Optimization",
                description: "Quarterly reporting, performance dashboards, and impact validation — converting activity into verified outcomes and refining the model for maximum long-term durability.",
                color: "border-slate-200 bg-slate-50"
              }
            ].map(phase => (
              <div class={`flex items-start gap-5 p-6 border ${phase.color} rounded-2xl hover:shadow-md transition-all duration-200`}>
                <div class="w-12 h-12 bg-slate-900 text-white rounded-xl flex items-center justify-center font-black text-sm flex-shrink-0">
                  {phase.step}
                </div>
                <div>
                  <h3 class="font-bold text-slate-900 mb-2">{phase.title}</h3>
                  <p class="text-slate-600 text-sm leading-relaxed">{phase.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECT PARTNERS -->
    <section class="py-20 bg-slate-50">
