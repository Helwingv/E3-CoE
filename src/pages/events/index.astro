---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyCTA from "../../components/StickyCTA.astro";
import EventsLatest from "../../components/react/EventsLatest";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  import.meta.env.VITE_SUPABASE_URL,
  import.meta.env.VITE_SUPABASE_ANON_KEY
);

const { data: upcomingEvents } = await supabase
  .from("events_items")
  .select("id,title,slug,excerpt,event_date,end_date,venue,location")
  .eq("is_published", true)
  .gte("event_date", new Date().toISOString())
  .order("event_date", { ascending: true })
  .limit(3);

const featured = upcomingEvents ?? [];

const bgColors = ["bg-slate-900", "bg-slate-800", "bg-slate-700"];
const labels = ["Signature Event", "Featured Event", "Upcoming Event"];
---

<BaseLayout
  title="Events & Training | Vision 8:28"
  description="Vision 8:28 Events & Training convene decision-makers, economic development professionals, entrepreneurs, and policymakers to accelerate real-world outcomes."
>
  <div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">

    <!-- HERO -->
    <section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-32 overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-4xl">
          <div class="mb-8">
            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
              Where Leaders Learn.<br />Where Regions Rise.
            </h1>
            <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-3">
              Vision 8:28 Events & Training convene decision-makers, economic development professionals, entrepreneurs, educators, and policymakers to accelerate real-world outcomes.
            </p>
            <p class="text-lg text-[#24a4b9] font-semibold">
              From executive roundtables to hands-on workshops, we build the capacity behind community and economic transformation.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#events"
              class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg"
            >
              View Upcoming Events
            </a>
            <a
              href="#training"
              class="inline-block bg-white/10 border border-white/20 text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/20 transition-colors duration-200"
            >
              Explore Training Programs
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED EVENTS -->
    <section id="events" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-6">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Signature Convenings That Shape Strategy
          </h2>
          <p class="text-lg text-slate-600 max-w-4xl mx-auto">
            Vision 8:28 events are not "Programming For The Sake Of Programming." — they are catalytic by design, and intended to produce outcomes.
          </p>
        </div>

        {featured.length > 0 ? (
          <div class="space-y-6 mt-14">
            {featured.map((event, i) => {
              const eventDate = new Date(event.event_date);
              const endDate = event.end_date ? new Date(event.end_date) : null;
              const fmtDate = eventDate.toLocaleDateString("en-US", { weekday: "long", year: "numeric", month: "long", day: "numeric" });
              const fmtTime = eventDate.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });
              const fmtEndTime = endDate ? endDate.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true }) : null;
              return (
                <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
                  <div class="grid lg:grid-cols-3">
                    <div class={`${bgColors[i % 3]} text-white p-10 flex flex-col justify-between`}>
                      <div>
                        <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-3">{labels[i % 3]}</div>
                        <h3 class="text-2xl font-bold mb-4 leading-snug">{event.title}</h3>
                        {event.excerpt && <p class="text-slate-400 leading-relaxed text-sm">{event.excerpt}</p>}
                      </div>
                      <div class="mt-8 pt-8 border-t border-slate-600/50 space-y-3">
                        <a href={`/events/${event.slug}`} class="block text-center bg-[#24a4b9] text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-[#1d8a9d] transition-colors duration-200">
                          Register Now
                        </a>
                        <a href="/contact" class="block text-center bg-white/10 border border-white/20 text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-white/20 transition-colors duration-200">
                          Become A Sponsor
                        </a>
                      </div>
                    </div>
                    <div class="lg:col-span-2 p-10 flex flex-col justify-center">
                      <div class="grid sm:grid-cols-2 gap-6">
                        <div class="space-y-5">
                          <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-[#24a4b9]/10 flex items-center justify-center flex-shrink-0">
                              <svg class="w-5 h-5 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                              </svg>
                            </div>
                            <div>
                              <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mb-1">Date</p>
                              <p class="text-slate-900 font-semibold text-sm">{fmtDate}</p>
                              <p class="text-slate-500 text-xs">{fmtTime}{fmtEndTime ? ` – ${fmtEndTime}` : ""}</p>
                            </div>
                          </div>
                          {(event.venue || event.location) && (
                            <div class="flex items-start gap-4">
                              <div class="w-10 h-10 rounded-xl bg-[#24a4b9]/10 flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                              </div>
                              <div>
                                <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mb-1">Location</p>
                                {event.venue && <p class="text-slate-900 font-semibold text-sm">{event.venue}</p>}
                                {event.location && <p class="text-slate-500 text-xs">{event.location}</p>}
                              </div>
                            </div>
                          )}
                        </div>
                        <div class="flex items-center">
                          <a href={`/events/${event.slug}`} class="group flex items-center gap-3 text-[#24a4b9] font-semibold text-sm hover:underline">
                            View Full Details & Register
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-16 mt-14 border border-dashed border-slate-300 rounded-2xl">
            <p class="text-slate-400 font-medium">No upcoming events scheduled. Check back soon.</p>
          </div>
        )}
      </div>
    </section>

    <!-- TRAINING & CAPACITY BUILDING -->
    <section id="training" class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Building The Practitioners Behind The Policy
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Vision 8:28 training programs translate strategy into execution.
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">

          <!-- Training 1 -->
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col">
            <div class="bg-slate-900 text-white p-8">
              <div class="text-[#24a4b9] text-xs font-bold uppercase tracking-widest mb-3">Program 01</div>
              <h3 class="text-xl font-bold mb-3 leading-snug">Economic Development Practitioner Training</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Designed for EDC professionals, municipal staff, and community development leaders seeking execution-ready frameworks.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <div class="mb-6">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-3">Modules Include</h4>
                <ul class="space-y-2">
                  {[
                    "Strategic economic planning",
                    "Data-driven decision making",
                    "Public-private partnership structuring",
                    "Capital stack alignment",
                    "Performance measurement systems"
                  ].map(item => (
                    <li class="flex items-start gap-2">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#24a4b9] flex-shrink-0 mt-2"></div>
                      <span class="text-slate-600 text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="mb-8">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-3">Format</h4>
                <div class="flex flex-wrap gap-2">
                  {["Multi-day intensives", "Virtual workshops", "Custom on-site"].map(f => (
                    <span class="text-xs font-medium bg-slate-100 text-slate-700 px-3 py-1 rounded-full">{f}</span>
                  ))}
                </div>
              </div>
              <div class="mt-auto space-y-2">
                <a href="/contact" class="block text-center bg-[#24a4b9] text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-[#1d8a9d] transition-colors duration-200">
                  View Training Calendar
                </a>
                <a href="/contact" class="block text-center border border-slate-300 text-slate-700 px-6 py-3 rounded-lg font-semibold text-sm hover:border-slate-400 transition-colors duration-200">
                  Request Custom Training
                </a>
              </div>
            </div>
          </div>

          <!-- Training 2 -->
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col">
            <div class="bg-slate-800 text-white p-8">
              <div class="text-[#24a4b9] text-xs font-bold uppercase tracking-widest mb-3">Program 02</div>
              <h3 class="text-xl font-bold mb-3 leading-snug">Small Business & Entrepreneurship Accelerator Workshops</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Focused on equipping entrepreneurs and their support organizations to scale, access capital, and compete in modern markets.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <div class="mb-6">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-3">Workshop Focus</h4>
                <ul class="space-y-2">
                  {[
                    "Access to capital strategy",
                    "Procurement readiness",
                    "Growth scaling frameworks",
                    "Innovation ecosystem navigation"
                  ].map(item => (
                    <li class="flex items-start gap-2">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#24a4b9] flex-shrink-0 mt-2"></div>
                      <span class="text-slate-600 text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="mb-8">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-3">Ideal For</h4>
                <div class="flex flex-wrap gap-2">
                  {["Small businesses", "ESOs", "EDC SB teams"].map(f => (
                    <span class="text-xs font-medium bg-slate-100 text-slate-700 px-3 py-1 rounded-full">{f}</span>
                  ))}
                </div>
              </div>
              <div class="mt-auto">
                <a href="/contact" class="block text-center bg-[#24a4b9] text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-[#1d8a9d] transition-colors duration-200">
                  Register For An Accelerator Session
                </a>
              </div>
            </div>
          </div>

          <!-- Training 3 -->
          <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col">
            <div class="bg-slate-700 text-white p-8">
              <div class="text-[#24a4b9] text-xs font-bold uppercase tracking-widest mb-3">Program 03</div>
              <h3 class="text-xl font-bold mb-3 leading-snug">Workforce & Talent Development Labs</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Interactive labs designed to align regional talent pipelines with employer demand and modernize how workforce systems operate.</p>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <div class="mb-8">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-3">Lab Focus Areas</h4>
                <ul class="space-y-2">
                  {[
                    "Industry cluster alignment",
                    "Apprenticeship strategy design",
                    "Credential modernization",
                    "Talent pipeline partnerships"
                  ].map(item => (
                    <li class="flex items-start gap-2">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#24a4b9] flex-shrink-0 mt-2"></div>
                      <span class="text-slate-600 text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="mt-auto">
                <a href="/contact" class="block text-center bg-[#24a4b9] text-white px-6 py-3 rounded-lg font-semibold text-sm hover:bg-[#1d8a9d] transition-colors duration-200">
                  Join A Workforce Lab
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ON-DEMAND LEARNING HUB -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-4">On-Demand Learning Hub</div>
            <h2 class="text-4xl font-bold text-slate-900 mb-6">
              Learn On Your Schedule
            </h2>
            <p class="text-lg text-slate-600 leading-relaxed mb-8">
              Vision 8:28 offers digital learning modules and recorded sessions for continued professional development — accessible wherever you are, whenever you need it.
            </p>
            <div class="grid sm:grid-cols-2 gap-4 mb-10">
              {[
                { label: "Policy Briefings", icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
                { label: "Summit Recordings", icon: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" },
                { label: "Practitioner Toolkits", icon: "M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" },
                { label: "Leadership Interviews", icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" },
                { label: "Data Trend Updates", icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" }
              ].map(item => (
                <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
                  <div class="w-8 h-8 bg-[#24a4b9] bg-opacity-10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
                    </svg>
                  </div>
                  <span class="text-slate-700 font-medium text-sm">{item.label}</span>
                </div>
              ))}
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/contact" class="inline-block bg-[#24a4b9] text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-[#1d8a9d] transition-colors duration-200 shadow-lg">
                Access On-Demand Library
              </a>
              <a href="/contact" class="inline-block border-2 border-slate-300 text-slate-700 px-8 py-4 rounded-lg font-semibold text-lg hover:border-slate-400 transition-colors duration-200">
                Become A Member
              </a>
            </div>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8">
            <div class="text-center mb-8">
              <div class="w-16 h-16 bg-slate-900 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Member Access Hub</h3>
              <p class="text-slate-500 text-sm">Full library access for Vision 8:28 members</p>
            </div>
            <div class="space-y-3">
              {[
                { title: "2024 Regional Competitiveness Briefing", type: "Policy Brief", duration: "18 min read" },
                { title: "Workforce Pipeline Strategy Masterclass", type: "Summit Recording", duration: "52 min" },
                { title: "Capital Stack Alignment Toolkit", type: "Practitioner Toolkit", duration: "Download" },
                { title: "EDC Leadership Roundtable — Q4 2024", type: "Interview Series", duration: "44 min" }
              ].map(item => (
                <div class="flex items-start gap-4 bg-white border border-slate-200 rounded-xl px-5 py-4">
                  <div class="w-8 h-8 bg-[#24a4b9] bg-opacity-10 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-[#24a4b9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-slate-900 font-semibold text-sm truncate">{item.title}</p>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="text-[#24a4b9] text-xs font-medium">{item.type}</span>
                      <span class="text-slate-400 text-xs">·</span>
                      <span class="text-slate-500 text-xs">{item.duration}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-6 pt-5 border-t border-slate-200 text-center">
              <p class="text-slate-500 text-sm">Members unlock 50+ resources in the full library</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <div class="text-[#24a4b9] text-sm font-bold uppercase tracking-widest mb-4">Certification Pathways</div>
          <h2 class="text-4xl font-bold text-slate-900 mb-4">
            Professional Certification Pathways
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Vision 8:28 offers structured learning pathways designed to elevate practitioner credibility and regional capacity, culminating in recognized certifications.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-12">
          {[
            {
              number: "01",
              title: "Community Economic Development Strategy",
              description: "A comprehensive certification for practitioners leading community-level economic development initiatives and strategic planning."
            },
            {
              number: "02",
              title: "Regional Workforce Systems Alignment",
              description: "Designed for workforce development professionals building and managing talent pipeline systems across regional industry clusters."
            },
            {
              number: "03",
              title: "Public-Private Partnership Structuring",
              description: "For economic development leaders structuring complex PPP arrangements that drive investment, jobs, and community outcomes."
            }
          ].map(cert => (
            <div class="bg-white border border-slate-200 rounded-2xl p-8 hover:shadow-lg transition-all duration-200 flex flex-col">
              <div class="w-12 h-12 bg-slate-900 text-[#24a4b9] rounded-xl flex items-center justify-center font-bold text-lg mb-6 flex-shrink-0">
                {cert.number}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-3 leading-snug">{cert.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed flex-1">{cert.description}</p>
              <div class="mt-6 pt-5 border-t border-slate-100">
                <a href="/contact" class="text-[#24a4b9] font-semibold text-sm hover:underline">
                  Explore Certification Track →
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center">
          <a href="/contact" class="inline-block bg-slate-900 text-white px-10 py-4 rounded-lg font-semibold text-lg hover:bg-slate-800 transition-colors duration-200 shadow-lg">
            Explore All Certification Tracks
          </a>
        </div>
      </div>
    </section>

    <!-- CORPORATE & INSTITUTIONAL TRAINING -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-16 items-center">
