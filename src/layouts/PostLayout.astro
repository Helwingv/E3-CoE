---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.excerpt}>
  <article class="mx-auto max-w-3xl px-4 py-12 prose prose-zinc">
    <h1>{frontmatter.title}</h1>
    <p class="text-sm text-gray-500">{new Date(frontmatter.date).toLocaleDateString()}</p>
    <slot />
  </article>
</BaseLayout>
