---
import { site } from "../config/site";

const {
  title = site.name,
  subtitle = site.tagline,
  ctaPrimary = { href: "/about/make-a-difference", label: "Make A Difference" },
  ctaSecondary = { href: "/contact", label: "Contact Us" }
} = Astro.props;
---
<section class="relative bg-white">
  <!-- Photo: "People during Training Course" by Matheus Bertelli on Pexels -->
  <img
    src="/images/hero-training-course-1920.webp"
    srcset="/images/hero-training-course-960.webp 960w, /images/hero-training-course-1920.webp 1920w"
    sizes="100vw"
    width="1920"
    height="1280"
    alt=""
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover object-[50%_65%]"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-e3-900/90 via-e3-800/75 to-e3-700/50"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-16 grid lg:grid-cols-2 gap-8 items-center">
    <div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">{title}</h1>
      {subtitle && <p class="mt-4 text-lg text-white border-l-4 border-e3 pl-4 italic">{subtitle}</p>}
      <div class="mt-6 flex gap-3">
        <a href={ctaPrimary.href} class="inline-flex rounded-md bg-e3 px-4 py-2 text-white font-semibold hover:bg-e3-600 transition-colors">{ctaPrimary.label}</a>
        <a href={ctaSecondary.href} class="inline-flex rounded-md border-2 border-white text-white px-4 py-2 font-semibold hover:bg-white hover:text-e3-900 transition-all">{ctaSecondary.label}</a>
      </div>
    </div>
    <div class="rounded-2xl border-t-8 border-e3 bg-white p-6 shadow-lg">
      <h2 class="font-semibold text-e3-700 mb-2">Our Mission</h2>
      <p class="text-sm text-charcoal">{site.mission}</p>
      <h2 class="font-semibold text-e3-700 mt-4 mb-2">Our Vision</h2>
      <p class="text-sm text-charcoal">{site.vision}</p>
      <h2 class="font-semibold text-e3-700 mt-4 mb-2">Our Purpose</h2>
      <p class="text-sm text-charcoal">{site.purpose}</p>
    </div>
  </div>
</section>
