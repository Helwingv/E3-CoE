---
import { site } from "../config/site";

const {
  title = site.name,
  subtitle = site.tagline,
  ctaPrimary = { href: "/donate", label: "Donate" },
  ctaSecondary = { href: "/about/get-involved", label: "Get Involved" }
} = Astro.props;
---
<section class="relative bg-white">
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/pexels-jibarofoto-17026868.jpg');"></div>
  <div class="absolute inset-0 bg-black bg-opacity-50"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-16 grid lg:grid-cols-2 gap-8 items-center">
    <div>
      <h1 class="text-4xl font-extrabold tracking-tight text-white">{title}</h1>
      {subtitle && <p class="mt-4 text-lg text-white">{subtitle}</p>}
      <div class="mt-6 flex gap-3">
        <a href={ctaPrimary.href} class="inline-flex rounded-md bg-community-orange px-4 py-2 text-white font-semibold hover:opacity-90 transition-opacity">{ctaPrimary.label}</a>
        <a href={ctaSecondary.href} class="inline-flex rounded-md border-2 border-white text-white px-4 py-2 font-semibold hover:bg-white hover:text-deep-navy transition-all">{ctaSecondary.label}</a>
      </div>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-lg">
      <h2 class="font-semibold text-unity-blue mb-2">Our Mission</h2>
      <p class="text-sm text-charcoal">{site.mission}</p>
      <h2 class="font-semibold text-unity-blue mt-4 mb-2">Our Vision</h2>
      <p class="text-sm text-charcoal">{site.vision}</p>
      <h2 class="font-semibold text-unity-blue mt-4 mb-2">Our Purpose</h2>
      <p class="text-sm text-charcoal">{site.purpose}</p>
    </div>
  </div>
</section>
