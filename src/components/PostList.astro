---
import { getCollection } from "astro:content";

const { limit = 10 } = Astro.props;
const posts = (await getCollection("posts"))
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, limit);
---
<ul class="grid md:grid-cols-3 gap-6">
  {posts.map(p => (
    <li class="border rounded-lg p-4 bg-white hover:shadow-md transition">
      <h3 class="font-semibold">
        <a href={`/news/${p.slug}`} class="hover:text-brand">{p.data.title}</a>
      </h3>
      {p.data.excerpt && <p class="text-sm text-gray-600 mt-1">{p.data.excerpt}</p>}
      <p class="text-xs text-gray-500 mt-2">{new Date(p.data.date).toLocaleDateString()}</p>
    </li>
  ))}
</ul>
